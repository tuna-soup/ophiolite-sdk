{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/schemas/recipe-journal-v1.schema.json",
  "title": "ophiolite.recipe-journal/1",
  "description": "A recipe run's journal, <work>/journal.json (E112 s2): client state, written by ophiolite.recipe_runs.run before and after each step. Local and provisional; the server's own records are the guard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recipe_name", "recipe_sha256", "run_id", "principal", "bindings", "steps"],
  "properties": {
    "schema": {"const": "ophiolite.recipe-journal/1"},
    "recipe_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "recipe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "project", "identity"],
      "properties": {"url": {"type": "string"}, "project": {"type": "string"}, "identity": {"type": "object"}}
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text", "asset_id", "revision"],
            "properties": {"type": {"const": "item"}, "text": {"type": "string"}, "asset_id": {"type": "string"}, "revision": {"type": "string"}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path", "sha256", "size"],
            "properties": {"type": {"const": "file"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                           "size": {"type": "integer", "minimum": 0}}
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "step", "state", "attempt", "folder", "result", "sentence", "decided_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"},
          "step": {"enum": ["residuals", "publish", "states", "deliver"]},
          "state": {"enum": ["waiting", "started", "finished", "failed", "stopped", "unknown", "set_aside"]},
          "attempt": {"type": "integer", "minimum": 1},
          "folder": {"type": ["string", "null"], "pattern": "^steps/[0-9]+-[a-z][a-z0-9-]{0,30}/a[0-9]+$"},
          "result": {"type": ["object", "null"]},
          "sentence": {"type": ["string", "null"]},
          "decided_by": {"type": ["object", "null"]}
        }
      }
    }
  }
}
