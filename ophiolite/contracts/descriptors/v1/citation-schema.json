{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/descriptors/v1/citation-schema.json",
  "title": "Release citation 1",
  "description": "The structure of the citation block of a bundle v2 manifest (ophiolite.citation/1, bundle 2.15, E147 s0): what a release is, in the words the standard descriptors (RO-Crate 1.1, Croissant 1.0, DataCite kernel-4.3) are derived from. Structure only: the bundle minor, a creator's identifier scheme by kind, a notice exactly when the licence is null, prov only beside assets, names listed once and the media type of every asset file row are descriptors/v1/descriptors.py's (validate_citation). licence is one of the open licences of the rights policy by its exact SPDX id, or null when the rights basis is not an open licence; doi stays null until a registration record sets it (E147 s5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "description", "published", "creators", "publisher", "licence", "doi", "descriptors"],
  "properties": {
    "schema": {"const": "ophiolite.citation/1"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "description": {"type": "string", "minLength": 1, "maxLength": 5000},
    "published": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "creators": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/creator"}},
    "publisher": {"$ref": "#/$defs/publisher"},
    "licence": {"anyOf": [
      {"type": "object", "additionalProperties": false, "required": ["spdx"], "properties": {"spdx": {"enum": ["CC0-1.0", "CC-BY-4.0", "PDDL-1.0", "ODC-By-1.0"]}}},
      {"type": "null"}
    ]},
    "notice": {"type": "string", "minLength": 1, "maxLength": 1000},
    "doi": {"const": null},
    "prov": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"const": "prov.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 33554432}
      }
    },
    "descriptors": {"type": "array", "minItems": 1, "items": {"enum": ["ro-crate-metadata.json", "croissant.json", "datacite.json"]}}
  },
  "$defs": {
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["person", "organisation"]},
        "identifier": {"type": "string", "pattern": "^https://(orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]|ror\\.org/0[a-z0-9]{6}[0-9]{2})$"}
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "identifier": {"type": "string", "pattern": "^https://ror\\.org/0[a-z0-9]{6}[0-9]{2}$"}
      }
    }
  }
}
