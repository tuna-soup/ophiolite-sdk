{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ophiolite.agent-mapping-evidence/1",
  "title": "The evidence of each pick of a mapping: its class, who stated it, what earlier review supports it (E153 s0)",
  "description": "The row the gateway already derives for every pick of a mapping, published as contract before anything changes an answer. A row names a target `field` or a layout's stated `declaration` (exactly one), its `class`, `by` (who stated it: the connection, you, or a suggestion's rule; null for `none` and `previously-reviewed`), `reuse` and, exactly for `previously-reviewed`, `supported_by`: one tagged record (a reviewed mapping version, a reviewed import, or a layout at its immutable version). `how` (the layout's match) is present exactly when `reuse` is `layout`. The rows of a database table's `column_basis.rows` and the `fields` and `declarations` of a file landing's layout basis are rows of this shape. The schema checks the shape and these cross-field rules only; it cannot know who asked, so that an agent's request never yields `by: you` is a rule of the server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "field": {"type": "string", "minLength": 1, "maxLength": 160},
        "declaration": {"type": "string", "minLength": 1, "maxLength": 160},
        "class": {"enum": ["declared", "previously-reviewed", "inferred", "none"]},
        "by": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "reuse": {"enum": ["same-table", "layout", null]},
        "supported_by": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/mapping_version"}, {"$ref": "#/$defs/import_id"}, {"$ref": "#/$defs/layout"}]},
        "how": {"enum": ["exact", "reordered"]}
      },
      "oneOf": [{"required": ["field"]}, {"required": ["declaration"]}],
      "allOf": [
        {
          "if": {"properties": {"class": {"const": "previously-reviewed"}}},
          "then": {"required": ["supported_by"], "properties": {"supported_by": {"not": {"type": "null"}}, "by": {"const": null}}},
          "else": {"properties": {"supported_by": {"const": null}, "reuse": {"const": null}}}
        },
        {
          "if": {"properties": {"class": {"enum": ["declared", "inferred"]}}},
          "then": {"required": ["by"], "properties": {"by": {"type": "string"}}}
        },
        {
          "if": {"properties": {"class": {"const": "none"}}},
          "then": {"properties": {"by": {"const": null}}}
        },
        {
          "if": {"required": ["reuse"], "properties": {"reuse": {"const": "layout"}}},
          "then": {"required": ["how"]},
          "else": {"not": {"required": ["how"]}}
        }
      ]
    },
    "mapping_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_version"],
      "properties": {"mapping_version": {"type": "integer", "minimum": 1}}
    },
    "import_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_id"],
      "properties": {"import_id": {"type": "string", "minLength": 1, "maxLength": 64}}
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "version"],
      "properties": {"layout": {"type": "string", "minLength": 1, "maxLength": 160}, "version": {"type": "integer", "minimum": 1}}
    }
  }
}
