{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/procedures/v1/check-answer.json",
  "x-ophiolite": {
    "id": "ophiolite.check-answer/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "AnswerRow": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "What the row is about, in the tool's words (a well and a top, a cell, a line)",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Key",
          "type": "string"
        },
        "measure": {
          "description": "What was measured, in the tool's words",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Measure",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The measured value, or null when there is none",
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The unit of value and limit, or null",
          "title": "Unit"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The limit the value was held to, or null",
          "title": "Limit"
        },
        "pass": {
          "description": "Whether this row meets the limit, as the tool judged it",
          "title": "Pass",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "measure",
        "value",
        "unit",
        "limit",
        "pass"
      ],
      "title": "AnswerRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`ophiolite.check-answer/1` (E179 s0): what the outcome form of a check writes to `/output/answer.json`, at most\n1 MiB and the only file there.",
  "properties": {
    "schema": {
      "const": "ophiolite.check-answer/1",
      "title": "Schema",
      "type": "string"
    },
    "state": {
      "enum": [
        "passed",
        "failed",
        "not_compared"
      ],
      "title": "State",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the tool did not compare, in its own words; present exactly when state is not_compared",
      "title": "Reason"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/AnswerRow"
      },
      "maxItems": 1000,
      "title": "Rows",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "state",
    "rows"
  ],
  "title": "CheckAnswer",
  "type": "object"
}
