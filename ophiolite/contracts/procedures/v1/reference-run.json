{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/procedures/v1/reference-run.json",
  "x-ophiolite": {
    "id": "ophiolite.reference-run/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "AbsoluteTolerance": {
      "additionalProperties": false,
      "description": "In the compared quantity's unit.",
      "properties": {
        "kind": {
          "const": "absolute",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "title": "AbsoluteTolerance",
      "type": "object"
    },
    "CheckDifferences": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "largest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Largest"
        },
        "value_to_missing": {
          "minimum": 0,
          "title": "Value To Missing",
          "type": "integer"
        },
        "missing_to_value": {
          "minimum": 0,
          "title": "Missing To Value",
          "type": "integer"
        },
        "first": {
          "items": {
            "$ref": "#/$defs/CheckSample"
          },
          "maxItems": 20,
          "title": "First",
          "type": "array"
        },
        "changed_range": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  }
                ]
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Changed Range"
        }
      },
      "required": [
        "count",
        "total",
        "largest",
        "value_to_missing",
        "missing_to_value",
        "first",
        "changed_range"
      ],
      "title": "CheckDifferences",
      "type": "object"
    },
    "CheckSample": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "title": "At"
        },
        "reference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        },
        "output": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output"
        }
      },
      "required": [
        "at",
        "reference",
        "output"
      ],
      "title": "CheckSample",
      "type": "object"
    },
    "ReferenceComparison": {
      "additionalProperties": false,
      "description": "E96's answer, with E96's semantics: `reason` only beside not_compared, `differences` the check/1 model of the rule.",
      "properties": {
        "rules_id": {
          "enum": [
            "series-compare/1",
            "grid-compare/1",
            "tops-compare/1",
            "trajectory-compare/1",
            "residual-compare/1"
          ],
          "title": "Rules Id",
          "type": "string"
        },
        "tolerance": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "absolute": "#/$defs/AbsoluteTolerance",
                  "relative": "#/$defs/RelativeTolerance"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/AbsoluteTolerance"
                },
                {
                  "$ref": "#/$defs/RelativeTolerance"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Tolerance"
        },
        "outcome": {
          "enum": [
            "passed",
            "differed",
            "not_compared"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "axis_mismatch",
                "unit_mismatch",
                "context_mismatch",
                "shape_mismatch",
                "another_kind",
                "declarations_missing",
                "declarations_incompatible",
                "unreadable",
                "too_large",
                "empty",
                "no_such_curve",
                "unit_unknown",
                "depth_basis_unknown",
                "depth_basis_mismatch",
                "wellbore_mismatch",
                "magnetic_north",
                "azimuth_reference_unknown",
                "azimuth_reference_mismatch",
                "grid_unknown",
                "datum_unknown",
                "datum_mismatch",
                "missing_angles",
                "start_not_at_datum",
                "reported_not_compared",
                "ambiguous_rows",
                "correspondence_mismatch",
                "inputs_differ"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "differences": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckDifferences"
            },
            {
              "$ref": "#/$defs/TopsDifferences"
            },
            {
              "$ref": "#/$defs/TrajectoryDifferences"
            },
            {
              "$ref": "#/$defs/ResidualDifferences"
            },
            {
              "type": "null"
            }
          ],
          "title": "Differences"
        }
      },
      "required": [
        "rules_id",
        "tolerance",
        "outcome",
        "reason",
        "differences"
      ],
      "title": "ReferenceComparison",
      "type": "object"
    },
    "ReferencePerson": {
      "additionalProperties": false,
      "description": "A person, never an agent (R-A2): a case set is chosen and a run started by a person; a case rests on a person's acceptance.",
      "properties": {
        "kind": {
          "const": "person",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name_at_time": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name At Time"
        }
      },
      "required": [
        "kind",
        "id",
        "name_at_time"
      ],
      "title": "ReferencePerson",
      "type": "object"
    },
    "ReferenceRunBox": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "One sandbox image for the whole run, selected at start",
          "maxLength": 200,
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "runtime": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runtime",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/ReferenceRunLimits"
        },
        "network": {
          "const": "none",
          "title": "Network",
          "type": "string"
        }
      },
      "required": [
        "image",
        "runtime",
        "limits",
        "network"
      ],
      "title": "ReferenceRunBox",
      "type": "object"
    },
    "ReferenceRunCases": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "description": "The set version run, frozen at start",
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "least": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Least"
        }
      },
      "required": [
        "version",
        "least"
      ],
      "title": "ReferenceRunCases",
      "type": "object"
    },
    "ReferenceRunCounts": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "minimum": 0,
          "title": "Cases",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "not_counted": {
          "minimum": 0,
          "title": "Not Counted",
          "type": "integer"
        }
      },
      "required": [
        "cases",
        "passed",
        "failed",
        "not_counted"
      ],
      "title": "ReferenceRunCounts",
      "type": "object"
    },
    "ReferenceRunLimits": {
      "additionalProperties": false,
      "properties": {
        "memory_mb": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Memory Mb",
          "type": "integer"
        },
        "seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Seconds",
          "type": "integer"
        },
        "cpus": {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "title": "Cpus",
          "type": "number"
        }
      },
      "required": [
        "memory_mb",
        "seconds",
        "cpus"
      ],
      "title": "ReferenceRunLimits",
      "type": "object"
    },
    "ReferenceRunOutput": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "bytes"
      ],
      "title": "ReferenceRunOutput",
      "type": "object"
    },
    "ReferenceRunResult": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "description": "Stable across set versions: runs of different versions count against the same case",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "title": "Case",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "not_counted"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no-longer-accepted",
                "tool_timeout",
                "tool_memory",
                "tool_crashed",
                "output_oversized",
                "output_missing",
                "output_malformed",
                "differed",
                "not_compared"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceRunOutput"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one compared output's digest and size"
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceComparison"
            },
            {
              "type": "null"
            }
          ]
        },
        "job": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The sandbox job that ran the case; null for a case not run",
          "title": "Job"
        }
      },
      "required": [
        "case",
        "outcome",
        "reason",
        "output",
        "comparison",
        "job"
      ],
      "title": "ReferenceRunResult",
      "type": "object"
    },
    "ReferenceRunTool": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The tool's catalogue name (its manifest `name`)",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}(/[a-z0-9][a-z0-9-]{0,62})?$",
          "title": "Name",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version_number": {
          "minimum": 1,
          "title": "Version Number",
          "type": "integer"
        },
        "label": {
          "description": "As people name it; it must read as words (the server's check, display.readable_label)",
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest",
        "version_number",
        "label"
      ],
      "title": "ReferenceRunTool",
      "type": "object"
    },
    "RelativeTolerance": {
      "additionalProperties": false,
      "description": "A dimensionless fraction of |reference|; a zero reference allows no difference.",
      "properties": {
        "kind": {
          "const": "relative",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "RelativeTolerance",
      "type": "object"
    },
    "ResidualDifferences": {
      "additionalProperties": false,
      "description": "E119b (D8, 1.2.0): `residual-compare/1`'s differences. `count` is the number of differing pairs and `total` the\nnumber of pairs (E96); `missing` and `extra` count the keys on one side only, `reasons_differ` the pairs whose\nreasons differ; `largest` is the largest |residual difference| (metres) of the pairs computed on both sides;\n`formation` is the one both results correspond to.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "largest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Largest"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "extra": {
          "minimum": 0,
          "title": "Extra",
          "type": "integer"
        },
        "reasons_differ": {
          "minimum": 0,
          "title": "Reasons Differ",
          "type": "integer"
        },
        "formation": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Formation",
          "type": "string"
        },
        "first": {
          "items": {
            "$ref": "#/$defs/ResidualPair"
          },
          "maxItems": 20,
          "title": "First",
          "type": "array"
        }
      },
      "required": [
        "count",
        "total",
        "largest",
        "missing",
        "extra",
        "reasons_differ",
        "formation",
        "first"
      ],
      "title": "ResidualDifferences",
      "type": "object"
    },
    "ResidualPair": {
      "additionalProperties": false,
      "description": "One (wellbore, occurrence) pair that differs: the top's md (metres; None for occurrence 0), each side's residual\n(metres) and reason; a side without the row has both None.",
      "properties": {
        "wellbore": {
          "pattern": "^wellbore-[0-9a-f]{32}$",
          "title": "Wellbore",
          "type": "string"
        },
        "occurrence": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "md": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Md"
        },
        "result_residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Residual"
        },
        "reference_residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Residual"
        },
        "result_reason": {
          "anyOf": [
            {
              "enum": [
                "grazing",
                "along-surface",
                "uncertain",
                "no-surface-data",
                "ends-above",
                "starts-below",
                "no-trajectory",
                "no-top",
                "many-crossings"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Reason"
        },
        "reference_reason": {
          "anyOf": [
            {
              "enum": [
                "grazing",
                "along-surface",
                "uncertain",
                "no-surface-data",
                "ends-above",
                "starts-below",
                "no-trajectory",
                "no-top",
                "many-crossings"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Reason"
        }
      },
      "required": [
        "wellbore",
        "occurrence",
        "md",
        "result_residual",
        "reference_residual",
        "result_reason",
        "reference_reason"
      ],
      "title": "ResidualPair",
      "type": "object"
    },
    "TopsDifferences": {
      "additionalProperties": false,
      "description": "E110 (D4): `tops-compare/1`'s differences; `missing` and `extra` count the unpaired picks.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "largest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Largest"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "extra": {
          "minimum": 0,
          "title": "Extra",
          "type": "integer"
        },
        "first": {
          "items": {
            "$ref": "#/$defs/TopsPick"
          },
          "maxItems": 20,
          "title": "First",
          "type": "array"
        }
      },
      "required": [
        "count",
        "total",
        "largest",
        "missing",
        "extra",
        "first"
      ],
      "title": "TopsDifferences",
      "type": "object"
    },
    "TopsPick": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "result_md": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Md"
        },
        "reference_md": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Md"
        }
      },
      "required": [
        "name",
        "result_md",
        "reference_md"
      ],
      "title": "TopsPick",
      "type": "object"
    },
    "TrajectoryDifferences": {
      "additionalProperties": false,
      "description": "E110 (D4): `trajectory-compare/1`'s differences; `outside` counts stations past the reference's last md.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "largest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Largest"
        },
        "outside": {
          "minimum": 0,
          "title": "Outside",
          "type": "integer"
        },
        "first": {
          "items": {
            "$ref": "#/$defs/TrajectoryStation"
          },
          "maxItems": 20,
          "title": "First",
          "type": "array"
        }
      },
      "required": [
        "count",
        "total",
        "largest",
        "outside",
        "first"
      ],
      "title": "TrajectoryDifferences",
      "type": "object"
    },
    "TrajectoryStation": {
      "additionalProperties": false,
      "properties": {
        "md": {
          "title": "Md",
          "type": "number"
        },
        "distance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distance"
        }
      },
      "required": [
        "md",
        "distance"
      ],
      "title": "TrajectoryStation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One tool version run once on every case of one set version; written once when every case has ended, never changed.",
  "properties": {
    "schema": {
      "const": "ophiolite.reference-run/1",
      "title": "Schema",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "project": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ReferenceRunTool"
    },
    "cases": {
      "$ref": "#/$defs/ReferenceRunCases"
    },
    "started_by": {
      "$ref": "#/$defs/ReferencePerson"
    },
    "started_at": {
      "description": "Epoch seconds",
      "minimum": 0,
      "title": "Started At",
      "type": "number"
    },
    "finished_at": {
      "description": "Epoch seconds",
      "minimum": 0,
      "title": "Finished At",
      "type": "number"
    },
    "box": {
      "$ref": "#/$defs/ReferenceRunBox"
    },
    "results": {
      "description": "One per case of the set version, in its order",
      "items": {
        "$ref": "#/$defs/ReferenceRunResult"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/ReferenceRunCounts"
    }
  },
  "required": [
    "schema",
    "run_id",
    "project",
    "tool",
    "cases",
    "started_by",
    "started_at",
    "finished_at",
    "box",
    "results",
    "counts"
  ],
  "title": "ReferenceRun",
  "type": "object"
}
