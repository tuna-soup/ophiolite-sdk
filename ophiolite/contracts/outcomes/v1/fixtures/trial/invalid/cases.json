    "twenty-one-failing": {"base": "rejected-25", "op": "append", "path": ["outcomes", 0, "rows", "failing"],
                           "value": {"key": {"wellbore": "W-21", "occurrence": 0}, "measure": "residual", "value": 2.4, "unit": "m", "limit": 1.0, "pass": false, "reason": null},
                           "field": "failing"},
    "accepted-with-reason": {"base": "accepted", "op": "set", "path": ["outcomes", 0, "reason"], "value": "inputs", "field": "reason"},
