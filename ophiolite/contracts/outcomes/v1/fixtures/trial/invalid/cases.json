    "not-compared-rejecting-reason": {"base": "not-compared-unit", "op": "set", "path": ["outcomes", 0, "reason"], "value": "inputs", "field": "reason"},
    "measure-in-yards": {"base": "measured", "op": "set", "path": ["outcomes", 0, "measures", 2, "unit"], "value": "yd", "field": "unit"}
