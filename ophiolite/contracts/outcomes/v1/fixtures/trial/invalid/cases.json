    "not-tried-other-reason": {"base": "not-tried", "op": "set", "path": ["outcomes", 0, "reason"], "value": "inputs", "field": "reason"},
    "empty-without-sentence": {"base": "none-declared", "op": "set", "path": ["sentence"], "value": null, "field": "sentence"},
    "listed-with-sentence": {"base": "accepted", "op": "set", "path": ["sentence"], "value": "No outcome is declared for this kind.", "field": "sentence"},
