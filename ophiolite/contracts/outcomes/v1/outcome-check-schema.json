{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/outcomes/v1/outcome-check-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.outcome-check/1",
    "version": "1.4.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "AnswerRow": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "What the row is about, in the tool's words (a well and a top, a cell, a line)",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Key",
          "type": "string"
        },
        "measure": {
          "description": "What was measured, in the tool's words",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Measure",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The measured value, or null when there is none",
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The unit of value and limit, or null",
          "title": "Unit"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The limit the value was held to, or null",
          "title": "Limit"
        },
        "pass": {
          "description": "Whether this row meets the limit, as the tool judged it",
          "title": "Pass",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "measure",
        "value",
        "unit",
        "limit",
        "pass"
      ],
      "title": "AnswerRow",
      "type": "object"
    },
    "CheckEvaluator": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "outcome-evaluator/1",
          "title": "Contract",
          "type": "string"
        },
        "rule_version": {
          "const": 1,
          "title": "Rule Version",
          "type": "integer"
        }
      },
      "required": [
        "contract",
        "rule_version"
      ],
      "title": "CheckEvaluator",
      "type": "object"
    },
    "CheckMeasure": {
      "additionalProperties": false,
      "description": "E178 s0 (R1): one number the evaluation counted, named by its rule's `measures` (rules.json); a quantity in the\nresult's display unit without rounding, a count with no unit. A chain step's condition reads it (E178 design 4).",
      "properties": {
        "name": {
          "maxLength": 41,
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "number"
            }
          ],
          "description": "A quantity in `unit`, or a whole count when `unit` is null",
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "m",
                "ft"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The length unit of a quantity (the result's display unit); null for a count",
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "CheckMeasure",
      "type": "object"
    },
    "CheckRows": {
      "additionalProperties": false,
      "properties": {
        "computed": {
          "minimum": 0,
          "title": "Computed",
          "type": "integer"
        },
        "passing": {
          "minimum": 0,
          "title": "Passing",
          "type": "integer"
        },
        "failing_count": {
          "description": "Every failing row; `failing` lists the first 20 in (wellbore, occurrence) order",
          "minimum": 0,
          "title": "Failing Count",
          "type": "integer"
        },
        "failing": {
          "items": {
            "$ref": "#/$defs/FailingRow"
          },
          "maxItems": 20,
          "title": "Failing",
          "type": "array"
        },
        "not_computed": {
          "items": {
            "$ref": "#/$defs/NotComputedRow"
          },
          "maxItems": 20,
          "title": "Not Computed",
          "type": "array"
        }
      },
      "required": [
        "computed",
        "passing",
        "failing_count",
        "failing",
        "not_computed"
      ],
      "title": "CheckRows",
      "type": "object"
    },
    "CheckedDataRules": {
      "additionalProperties": false,
      "description": "E144 s4 (D5): the named data rules as run for this record, under one registry snapshot; no sentence is kept.",
      "properties": {
        "registry_version": {
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Registry Version",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/CheckedRuleResult"
          },
          "maxItems": 32768,
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "registry_version",
        "results"
      ],
      "title": "CheckedDataRules",
      "type": "object"
    },
    "CheckedInput": {
      "additionalProperties": false,
      "properties": {
        "slot": {
          "minLength": 1,
          "title": "Slot",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "asset_id",
        "revision"
      ],
      "title": "CheckedInput",
      "type": "object"
    },
    "CheckedOutcome": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "rule": {
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9.-]*/[0-9]+$",
          "title": "Rule",
          "type": "string"
        },
        "settings_sha256": {
          "description": "SHA-256 of the canonical settings of that version",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Settings Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "rule",
        "settings_sha256"
      ],
      "title": "CheckedOutcome",
      "type": "object"
    },
    "CheckedPublication": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "seq": {
          "description": "The seq of the publication's activity event (D3)",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "run",
        "role",
        "seq"
      ],
      "title": "CheckedPublication",
      "type": "object"
    },
    "CheckedResult": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "display_unit": {
          "anyOf": [
            {
              "enum": [
                "m",
                "ft"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The result's display unit, as the failing rows are told; required for a built-in rule, absent for a tool rule (E179 s0)",
          "title": "Display Unit"
        }
      },
      "required": [
        "asset_id",
        "revision"
      ],
      "title": "CheckedResult",
      "type": "object"
    },
    "CheckedRuleResult": {
      "additionalProperties": false,
      "description": "E144 s4 (D5): one named data rule's result (ophiolite.rule-results/1's, unchanged) on one bound input version.",
      "properties": {
        "rule": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*/[1-9][0-9]*$",
          "title": "Rule",
          "type": "string"
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "not-applicable"
          ],
          "title": "State",
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Count"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/Example"
          },
          "maxItems": 5,
          "title": "Examples",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "offline",
                "no-column",
                "no-context"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "context": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ContextVersion"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context"
        },
        "slot": {
          "minLength": 1,
          "title": "Slot",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "severity": {
          "enum": [
            "note",
            "warn",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "state",
        "count",
        "examples",
        "parameters",
        "reason",
        "context",
        "slot",
        "asset_id",
        "revision",
        "severity"
      ],
      "title": "CheckedRuleResult",
      "type": "object"
    },
    "CheckedTool": {
      "additionalProperties": false,
      "description": "E179 s0 (design 5): the tool version that judged, the box image selected for the evaluation, and how far it got:\n`admission` (no run started), `run` (the box stopped it, or no answer could be read) or `answer` (an answer was\nread). `label` and `version_number` are the manifest's inside the digest, so the record names the tool version\nwithout a catalogue read.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The box image selected for the evaluation; null when the server has none",
          "title": "Image"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "version_number": {
          "minimum": 1,
          "title": "Version Number",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "admission",
            "run",
            "answer"
          ],
          "title": "Stage",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolAnswer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The answer read, at stage answer; null otherwise"
        },
        "explanation": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tool's not_compared text, as it wrote it; null otherwise",
          "title": "Explanation"
        },
        "job": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E179 s1 (Q1d, outcome-check 1.4.0): the runner job that ran the box; null at stage admission, where no job ran. Check jobs are not listed by jobs/list or jobs/get, so an administrator finds the run here; the id grants no read",
          "title": "Job"
        }
      },
      "required": [
        "digest",
        "image",
        "label",
        "version_number",
        "stage",
        "answer",
        "explanation"
      ],
      "title": "CheckedTool",
      "type": "object"
    },
    "ContextVersion": {
      "additionalProperties": false,
      "description": "Another version of the project a project-context rule read (online only).",
      "properties": {
        "asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "kind"
      ],
      "title": "ContextVersion",
      "type": "object"
    },
    "EvaluatedAs": {
      "additionalProperties": false,
      "properties": {
        "person": {
          "description": "The declarer of the outcome version, whose reading rights the evaluation used (D2)",
          "minLength": 1,
          "title": "Person",
          "type": "string"
        }
      },
      "required": [
        "person"
      ],
      "title": "EvaluatedAs",
      "type": "object"
    },
    "Example": {
      "additionalProperties": false,
      "description": "One failing row, in the file's order: its 1-based data row, and its depth and value when the rule has them.",
      "properties": {
        "row": {
          "minimum": 1,
          "title": "Row",
          "type": "integer"
        },
        "depth": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Depth"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "row",
        "depth",
        "value"
      ],
      "title": "Example",
      "type": "object"
    },
    "FailingRow": {
      "additionalProperties": false,
      "properties": {
        "wellbore": {
          "title": "Wellbore",
          "type": "string"
        },
        "occurrence": {
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The residual in metres, with its sign; null for a row not computed",
          "title": "Residual"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The row's reason when it was not computed",
          "title": "Reason"
        }
      },
      "required": [
        "wellbore",
        "occurrence",
        "residual",
        "reason"
      ],
      "title": "FailingRow",
      "type": "object"
    },
    "NotComputedRow": {
      "additionalProperties": false,
      "properties": {
        "wellbore": {
          "title": "Wellbore",
          "type": "string"
        },
        "occurrence": {
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "wellbore",
        "occurrence",
        "reason"
      ],
      "title": "NotComputedRow",
      "type": "object"
    },
    "ToolAnswer": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "passed",
            "failed",
            "not_compared"
          ],
          "title": "State",
          "type": "string"
        },
        "rows": {
          "$ref": "#/$defs/ToolAnswerRows"
        }
      },
      "required": [
        "state",
        "rows"
      ],
      "title": "ToolAnswer",
      "type": "object"
    },
    "ToolAnswerRows": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "failing_count": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Failing Count",
          "type": "integer"
        },
        "listed": {
          "description": "The first 20 rows as the tool wrote them",
          "items": {
            "$ref": "#/$defs/AnswerRow"
          },
          "maxItems": 20,
          "title": "Listed",
          "type": "array"
        }
      },
      "required": [
        "count",
        "failing_count",
        "listed"
      ],
      "title": "ToolAnswerRows",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An acceptance record (E120 C2): one outcome version's built-in rule over one exact result version of one\npublication, with the bound input versions, as its declarer could read them; never changed. `reason` is set exactly\nwhen the verdict is `not_compared`, or `rejected` for validity, inputs or a named data rule (outcome-reasons.json\n`checks`).",
  "properties": {
    "schema": {
      "const": "ophiolite.outcome-check/1",
      "title": "Schema",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/CheckedOutcome"
    },
    "evaluator": {
      "$ref": "#/$defs/CheckEvaluator"
    },
    "result": {
      "$ref": "#/$defs/CheckedResult"
    },
    "publication": {
      "$ref": "#/$defs/CheckedPublication"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/CheckedInput"
      },
      "maxItems": 4096,
      "title": "Inputs",
      "type": "array"
    },
    "evaluated_as": {
      "$ref": "#/$defs/EvaluatedAs"
    },
    "verdict": {
      "enum": [
        "accepted",
        "rejected",
        "not_compared"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "rows_missing",
            "rows_unexpected",
            "rows_duplicated",
            "rows_mismatched",
            "inputs",
            "unit_mismatch",
            "no_validity",
            "nothing_computed",
            "data_rule",
            "data_rule_unread",
            "data_rule_missing",
            "tool_not_trusted",
            "tool_not_verified",
            "tool_withdrawn",
            "declarer_left",
            "sandbox_unavailable",
            "sandbox_off",
            "tool_timeout",
            "tool_memory",
            "tool_crashed",
            "answer_missing",
            "answer_malformed",
            "answer_oversized",
            "tool_not_compared",
            "inputs_unmatched"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "rows": {
      "$ref": "#/$defs/CheckRows"
    },
    "data_rules": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckedDataRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "E144 s4: present exactly when the outcome version names data rules"
    },
    "measures": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CheckMeasure"
          },
          "maxItems": 16,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "E178 s0 (R1): the numbers the evaluation counted, sorted by name, once each; written from E178 slice 2 when rows were computed, absent on an earlier record and when an earlier gate of the evaluation failed",
      "title": "Measures"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckedTool"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "E179 s0: present exactly when the outcome version's rule is tool-check/1"
    },
    "at": {
      "title": "At",
      "type": "number"
    }
  },
  "required": [
    "schema",
    "outcome",
    "evaluator",
    "result",
    "publication",
    "inputs",
    "evaluated_as",
    "verdict",
    "rows",
    "at"
  ],
  "title": "OutcomeCheck",
  "type": "object"
}
