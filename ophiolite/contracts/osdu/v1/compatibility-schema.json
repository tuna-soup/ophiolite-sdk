{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/osdu/v1/compatibility-schema.json",
  "title": "OSDU compatibility summary",
  "description": "The structure of osdu/v1/compatibility.json (ophiolite.osdu-compatibility/1, E167 s1): what one dated load record under docs/osdu-roundtrip/ showed, or nothing yet. Either no kinds and every other value null with the summary \"not yet verified\", or the record's date, edition, producer version, manifest digest, kinds and path with the sentence they form. Structure only: the sentence equal to the fields, the record path's date equal to the date and the service versions equal to the edition version are osdu/v1/compatibility.py's problems().",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schema", "lifecycle", "date", "edition", "mapper", "manifest", "kinds", "record", "summary"],
  "properties": {
    "schema": {"const": "ophiolite.osdu-compatibility/1"},
    "lifecycle": {"const": "preview"}
  },
  "oneOf": [
    {
      "title": "No record has landed",
      "properties": {
        "date": {"const": null},
        "edition": {"const": null},
        "mapper": {"const": null},
        "manifest": {"const": null},
        "kinds": {"type": "array", "maxItems": 0},
        "record": {"const": null},
        "summary": {"const": "not yet verified"}
      }
    },
    {
      "title": "A dated load record",
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "edition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "services"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"$ref": "#/$defs/version"},
            "services": {
              "type": "object",
              "additionalProperties": false,
              "required": ["storage", "schema-service"],
              "properties": {"storage": {"$ref": "#/$defs/version"}, "schema-service": {"$ref": "#/$defs/version"}}
            }
          }
        },
        "mapper": {"$ref": "#/$defs/version"},
        "manifest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+:wks:(master-data|work-product-component|dataset)--[A-Za-z][A-Za-z0-9.]*:[0-9]+\\.[0-9]+\\.[0-9]+$"}
        },
        "record": {"type": "string", "pattern": "^docs/osdu-roundtrip/[0-9]{4}-[0-9]{2}-[0-9]{2}/record\\.json$"},
        "summary": {"type": "string", "pattern": "^compatibility shown on (?!.*verified)"}
      }
    }
  ],
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"}
  }
}
