    {"name": "choose-on-declaration", "base": "wells-csv", "set": [[["declarations", 1, "decision"], {"by": "A. Reviewer", "at": "2026-11-02T12:05:00Z", "action": "choose", "column": "m"}]], "code": "decision-misplaced", "path": "$.declarations[1].decision.action", "by": "validator"},
