{
  "description": "Questions to an organisation (E145 s0), ophiolite.search-request/2. `valid` are accepted by both stages. Each `refused` case is one valid question (`base`) with one change: `set` pairs a path (keys and list indices) with a value, `delete` removes a key, `raw` replaces the JSON text. An object {\"repeat\": c, \"times\": n} anywhere in a path or value stands for the string c repeated n times. `expect` is the stage that refuses it first (`schema`: the model; `consistent`: check_request), the field it names and the closed reason. `schema_expressible` is true only when the published JSON Schema alone refuses it; a case marked false is accepted by that schema (the model or the consistency stage refuses it). Synthetic.",
  "valid": [
    {"name": "text-only", "request": {"organization_id": "org-e145", "text": "gamma ray"}},
    {"name": "kinds-only", "request": {"organization_id": "org-e145", "kinds": ["well-tops-csv/1", "deviation-csv/1"]}},
    {"name": "well-only", "request": {"organization_id": "org-e145", "well": "NO 34/10-A-3"}},
    {"name": "bbox-only", "request": {"organization_id": "org-e145", "bbox": {"minx": 400000, "miny": 6700000, "maxx": 450000, "maxy": 6750000, "crs": "EPSG:23031"}}},
    {"name": "since-until-only", "request": {"organization_id": "org-e145", "since": "2026-03-01T00:00:00Z", "until": "2026-11-01T00:00:00Z"}},
    {"name": "all-fields", "request": {"organization_id": "org-e145", "text": "gamma ray", "method": "words", "kinds": ["las2/1"], "well": "34/10-A-3",
      "bbox": {"minx": 400000, "miny": 6700000, "maxx": 450000, "maxy": 6750000, "crs": "EPSG:23031"}, "since": "2026-03-01T00:00:00Z",
      "until": "2026-11-01T00:00:00Z", "published_by": "alice", "projects": ["proj-a", "proj-c"], "include_archived": true, "cursor": "opaque-cursor-1", "limit": 50}},
    {"name": "limit-50", "request": {"organization_id": "org-e145", "text": "gamma ray", "limit": 50}},
    {"name": "bbox-4326-lonlat", "request": {"organization_id": "org-e145", "bbox": {"minx": 2, "miny": 50, "maxx": 4, "maxy": 52, "crs": "EPSG:4326"}}},
    {"name": "bbox-default-crs", "request": {"organization_id": "org-e145", "bbox": {"minx": 2.5, "miny": 51.5, "maxx": 3.5, "maxy": 52.5}}},
    {"name": "filter-only", "request": {"organization_id": "org-e145", "projects": ["proj-a"], "include_archived": true}},
    {"name": "text-200", "request": {"organization_id": "org-e145", "text": {"repeat": "g", "times": 200}}}
  ],
  "refused": [
    {"name": "unknown-filter", "base": "text-only", "set": [[["colour"], "red"]], "expect": {"stage": "schema", "field": "colour", "reason": "schema"}, "schema_expressible": true},
    {"name": "unknown-filter-nested", "base": "bbox-only", "set": [[["bbox", "foo"], 1]], "expect": {"stage": "schema", "field": "bbox.foo", "reason": "schema"}, "schema_expressible": true},
    {"name": "unknown-filter-long", "base": "text-only", "set": [[[{"repeat": "k", "times": 400}], "red"]], "expect": {"stage": "schema", "field": {"repeat": "k", "times": 400}, "reason": "schema"}, "schema_expressible": true},
    {"name": "organization-missing", "base": "text-only", "delete": [["organization_id"]], "expect": {"stage": "schema", "field": "organization_id", "reason": "schema"}, "schema_expressible": true},
