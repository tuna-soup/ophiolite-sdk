    {"name": "bbox-antimeridian", "base": "bbox-4326-lonlat", "set": [[["bbox"], {"minx": 170, "miny": -10, "maxx": -170, "maxy": 10, "crs": "OGC:CRS84"}]], "expect": {"stage": "consistent", "field": "bbox.minx", "reason": "antimeridian"}, "schema_expressible": false},
