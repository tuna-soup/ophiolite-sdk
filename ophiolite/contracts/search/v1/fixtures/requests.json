    {"name": "since-not-utc", "base": "since-until-only", "set": [[["since"], "2026-03-01T00:00:00+01:00"]], "expect": {"stage": "schema", "field": "since", "reason": "schema"}, "schema_expressible": true},
    {"name": "since-impossible-date", "base": "since-until-only", "set": [[["since"], "2026-02-30T00:00:00Z"]], "expect": {"stage": "consistent", "field": "since", "reason": "not-a-date"}, "schema_expressible": false},
    {"name": "since-hour-24", "base": "since-until-only", "set": [[["since"], "2026-03-01T24:00:00Z"]], "expect": {"stage": "consistent", "field": "since", "reason": "not-a-date"}, "schema_expressible": false},
    {"name": "until-null", "base": "since-until-only", "set": [[["until"], null]], "expect": {"stage": "schema", "field": "until", "reason": "schema"}, "schema_expressible": true},
    {"name": "limit-0", "base": "text-only", "set": [[["limit"], 0]], "expect": {"stage": "schema", "field": "limit", "reason": "schema"}, "schema_expressible": true},
    {"name": "limit-51", "base": "text-only", "set": [[["limit"], 51]], "expect": {"stage": "schema", "field": "limit", "reason": "schema"}, "schema_expressible": true},
