{
  "openapi": "3.1.0",
  "info": {
    "title": "Ophiolite scientific asset pilot API",
    "version": "1",
    "description": "M2 exact scientific reads. Browser uses CSRF-protected POST aliases to the same service."
  },
  "paths": {
    "/api/v1/projects/{project}/scientific-assets": {
      "get": {
        "description": "Permission-filtered bounded discovery",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "scopedBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "$ref": "./summary-schema.json"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Versioned error; see README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Busy: retry the same exact request after Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/scientific-assets/{asset}/revisions/{revision}": {
      "get": {
        "description": "Exact descriptor without creating a run",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "curve",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Required for descriptor and curve:<mnemonic>; artifact is independent of curve."
          },
          {
            "name": "profiles",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "The revision manifest profiles this reader verifies, comma separated (for example /1,/2,/3). Absent means /1,/2: a /3 revision is then served as its /2 view, with digest_v2 as its digest and no derivation_record."
          }
        ],
        "security": [
          {
            "scopedBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Versioned error; see README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Busy: retry the same exact request after Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/scientific-assets/{asset}/revisions/{revision}/representations/{representation}": {
      "get": {
        "description": "Exact bounded representation bytes",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "representation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "curve",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required for descriptor and curve:<mnemonic>; artifact is independent of curve."
          }
        ],
        "security": [
          {
            "scopedBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Versioned error; see README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Busy: retry the same exact request after Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/scientific-assets/{asset}/revisions/{revision}/slices/{axis}/{label}": {
      "get": {
        "description": "One inline, crossline or sample slice of a seismic volume (ophiolite.seismic-slice/1), read one inline chunk at a time; X-Content-SHA256 is the digest of the returned document",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "axis",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "inline",
                "crossline",
                "sample"
              ]
            }
          },
          {
            "name": "label",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Inline or crossline number as recorded in the trace headers; for a sample slice the 0-based sample number."
          }
        ],
        "security": [
          {
            "scopedBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized slice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./seismic-slice-schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Versioned error; see README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Busy: retry the same exact request after Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/scientific-assets/{asset}/revisions/{revision}/windows": {
      "get": {
        "description": "One page of a depth window of a retained revision's stored well curve (ophiolite.curve-window/1): raw samples at level 0, or runs, blocks and missing stretches at levels 1 to 17; at most 2,048 items a page. Only increasing depth axes are windowed (422 incompatible-context otherwise; read the whole curve). A conditional request (If-None-Match with an earlier strong ETag) is authorised first and answers 304 when the ETag is current.",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "curve",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The stored value curve (mnemonic); no default is inferred."
          },
          {
            "name": "top",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "Top of the depth window, in the curve's depth unit."
          },
          {
            "name": "base",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "Base of the depth window, in the curve's depth unit."
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 17
            },
            "description": "0: raw samples; 1-17: blocks of up to 2^level samples. Exactly one of level and rows."
          },
          {
            "name": "rows",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "description": "Item budget: the server chooses the smallest level whose item count is at most rows (level 17 when none is). Exactly one of level and rows."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The previous page's next; refused with another revision, range, level, shape or reference."
          },
          {
            "name": "reference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "md",
                "tvd",
                "tvdss"
              ]
            },
            "description": "Depth reference; only md is windowed (tvd and tvdss answer 422)."
          }
        ],
        "security": [
          {
            "scopedBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorised window page",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong; sha256 of every byte-determining input"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-cache"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "const": "Cookie, Authorization"
                }
              },
              "X-Ophiolite-Access-Generation": {
                "schema": {
                  "type": "string"
                },
                "description": "The asset's access generation (0 when never changed)"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./curve-window-schema.json"
                }
              }
            }
          },
          "304": {
            "description": "The If-None-Match ETag is current; no body",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong; sha256 of every byte-determining input"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-cache"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "const": "Cookie, Authorization"
                }
              },
              "X-Ophiolite-Access-Generation": {
                "schema": {
                  "type": "string"
                },
                "description": "The asset's access generation (0 when never changed)"
              }
            }
          },
          "default": {
            "description": "Versioned error; see README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Busy: retry the same exact request after Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/wells/{well}/versions/{version}/curve-assets/{asset}/revisions/{revision}/windows": {
      "get": {
        "description": "One page of a depth window of a native well curve asset (ophiolite.curve-window/1, identity.kind native), read through the caller’s own GetCurveAsset; MD only (tvd and tvdss answer 422). A conditional request (If-None-Match) still reads the curve as the caller and answers 304 when the ETag is current.",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "well",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "asset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "An immutable curve-asset revision (1 or later)."
          },
          {
            "name": "top",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "Top of the depth window, in the curve's depth unit."
          },
          {
            "name": "base",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "Base of the depth window, in the curve's depth unit."
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 17
            },
            "description": "0: raw samples; 1-17: blocks of up to 2^level samples. Exactly one of level and rows."
          },
          {
            "name": "rows",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "description": "Item budget: the server chooses the smallest level whose item count is at most rows (level 17 when none is). Exactly one of level and rows."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The previous page's next; refused with another revision, range, level, shape or reference."
          },
          {
            "name": "reference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "md",
                "tvd",
                "tvdss"
              ]
            },
            "description": "Depth reference; only md is windowed (tvd and tvdss answer 422)."
          }
        ],
        "security": [
          {
            "scopedBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorised window page",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong; sha256 of every byte-determining input"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-cache"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "const": "Cookie, Authorization"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./curve-window-schema.json"
                }
              }
            }
          },
          "304": {
            "description": "The If-None-Match ETag is current; no body",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong; sha256 of every byte-determining input"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-cache"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "const": "Cookie, Authorization"
                }
              }
            }
          },
          "default": {
            "description": "Versioned error; see README",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Busy: retry the same exact request after Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "scopedBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code",
          "message",
          "remedy",
          "docs",
          "request_id"
        ],
        "description": "Every refusal (E31): error is kept for existing clients and equals message; request_id equals the X-Request-Id header.",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "The stable machine-readable code; see docs"
          },
          "message": {
            "type": "string"
          },
          "remedy": {
            "type": "string",
            "minLength": 1,
            "description": "What the caller can do next"
          },
          "docs": {
            "type": "string",
            "description": "The code's anchor on the errors reference page, /docs/reference/errors/#<code>"
          },
          "request_id": {
            "type": "string",
            "description": "Equals the X-Request-Id response header; quote it when reporting a failure"
          }
        }
      }
    }
  }
}
