{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/bundles/v1/manifest-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.portable-bundle/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "title": "PortableBundleManifest",
  "description": "The entry point of a portable bundle directory: an exact selection of scientific revisions with their files, digests, served context, permitted lineage, omissions and losses. Readers accept bundle_version major 1 and refuse other majors. Checksums show integrity, not authorship or scientific correctness. Unknown fields are extensions and are kept.",
  "type": "object",
  "required": [
    "schema",
    "bundle_version",
    "created_at",
    "exporter",
    "scope",
    "selection",
    "assets",
    "groups",
    "recommendations",
    "limits",
    "notice"
  ],
  "properties": {
    "schema": {
      "const": "ophiolite.portable-bundle/1"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "exporter": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "scope": {
      "const": "selection",
      "description": "A bundle holds exactly the selected revisions; it never claims to be a complete project."
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/BundleSelected"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/BundleAsset"
      }
    },
    "groups": {
      "type": "null",
      "description": "Result groups are not represented in bundle 1.0; explicitly absent."
    },
    "recommendations": {
      "type": "null",
      "description": "Recommendations are not represented in bundle 1.0; explicitly absent."
    },
    "limits": {
      "type": "object",
      "required": [
        "max_assets",
        "max_file_bytes",
        "max_total_bytes"
      ],
      "properties": {
        "max_assets": {
          "type": "integer",
          "minimum": 1
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "notice": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "BundleSelected": {
      "type": "object",
      "required": [
        "asset_id",
        "revision",
        "curves"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "curves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "BundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/[0-9]{1,3}/[A-Za-z0-9._-]{1,120}$"
        },
        "role": {
          "enum": [
            "original",
            "descriptor",
            "normalized"
          ]
        },
        "curve": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        }
      }
    },
    "BundleAsset": {
      "type": "object",
      "required": [
        "asset_id",
        "revision",
        "origin",
        "profile",
        "files",
        "parents",
        "parent_visibility",
        "omissions",
        "losses"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "enum": [
            "source-reference",
            "retained-capture",
            "managed-derived"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "files": {
          "type": "array",
          "minItems": 2,
          "maxItems": 129,
          "items": {
            "$ref": "#/$defs/BundleFile"
          }
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleHistory"
            },
            {
              "type": "null"
            }
          ],
          "description": "The descriptor's history block as served (managed results), else null."
        },
        "parents": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/BundleParent"
          }
        },
        "parent_visibility": {
          "enum": [
            "complete",
            "restricted"
          ]
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "losses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BundleHistory": {
      "type": "object",
      "required": [
        "number",
        "count",
        "head_revision"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "head_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BundleParent": {
      "type": "object",
      "required": [
        "authority",
        "key",
        "revision"
      ],
      "properties": {
        "authority": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        }
      }
    }
  }
}
