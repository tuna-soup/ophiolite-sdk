    {"name": "wells-named-tops", "base": "recipe-wells", "set": [[["folder", "items", 0, "kind"], "well-tops"]], "code": "kind-profile", "path": "$.folder.items[0].kind"},
    {"name": "a-grid-with-a-parquet-name", "base": "wells-grid", "set": [[["folder", "items", 1, "path"], "items/grid.parquet"]], "code": "item-suffix", "path": "$.folder.items[1].path"},
    {"name": "an-item-without-its-file", "base": "recipe-wells", "set": [[["folder", "items", 0, "path"], "items/other.parquet"]], "code": "item-file", "path": "$.folder.items[0].path"},
    {"name": "a-file-without-its-item", "base": "wells-grid", "delete": [["folder", "items", 1]], "code": "item-file", "path": "$.folder.files[1].path"},
    {"name": "wells-with-a-trajectory-kind", "base": "recipe-wells", "set": [[["folder", "items", 0, "osdu"], {"kind": "osdu:wks:work-product-component--WellboreTrajectory:1.4.0"}]], "code": "osdu-kind", "path": "$.folder.items[0].osdu"},
    {"name": "a-declaration-the-target-lacks", "base": "recipe-wells", "set": [[["folder", "items", 0, "declarations", 1, "name"], "azimuth_reference"]], "code": "declaration-unknown", "path": "$.folder.items[0].declarations[1]"},
    {"name": "a-unit-the-target-lacks", "base": "recipe-wells", "set": [[["folder", "items", 0, "declarations", 1, "value"], "km"]], "code": "declaration-unknown", "path": "$.folder.items[0].declarations[1]"},
    {"name": "two-crs-for-one-item", "base": "recipe-wells", "set": [[["folder", "items", 0, "declarations", 2], {"name": "crs", "value": "EPSG:4326"}]], "code": "crs-conflict", "path": "$.folder.items[0].declarations[2]"},
    {"name": "a-table-without-its-row-count", "base": "recipe-wells", "set": [[["folder", "items", 0, "rows"], null]], "code": "rows-type", "path": "$.folder.items[0].rows"},
    {"name": "a-grid-with-a-row-count", "base": "wells-grid", "set": [[["folder", "items", 1, "rows"], 4]], "code": "rows-type", "path": "$.folder.items[1].rows"},
    {"name": "a-v1-folder-goes-to-its-own-validator", "base": "v1-wells", "set": [[["folder", "recipe", "sha256"], "c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1"]], "code": "recipe-digest", "path": "$.folder.recipe.sha256"}
  ]
