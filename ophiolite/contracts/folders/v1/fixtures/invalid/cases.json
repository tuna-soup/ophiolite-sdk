{
  "description": "E117 s0: one change to a valid fixture folder's manifest.json per case, everything else left valid; validate() raises exactly `code` at `path`. `set` puts a value at a key path (an index one past the end appends), `delete` removes one. Every rule code of folders/v1/folder.py CODES has a case here (folder-spec.py checks it).",
  "cases": [
    {"name": "an-envelope-older-than-folders", "base": "recipe-wells", "set": [[["bundle_version"], "2.11.0"]], "code": "manifest-invalid", "path": "$.bundle_version"},
    {"name": "a-folder-2-in-a-2-13-envelope", "base": "wells-grid", "set": [[["bundle_version"], "2.13.0"]], "code": "manifest-invalid", "path": "$.bundle_version"},
    {"name": "an-unknown-folder-schema", "base": "recipe-wells", "set": [[["folder", "schema"], "ophiolite.project-folder/next"]], "code": "schema-unknown", "path": "$.folder.schema"},
    {"name": "no-writer", "base": "wells-grid", "delete": [["folder", "writer"]], "code": "schema-required", "path": "$.folder.writer"},
    {"name": "another-writer-with-a-recipe", "base": "recipe-wells", "set": [[["folder", "writer", "name"], "ophiolite-fixtures"]], "code": "recipe-writer", "path": "$.folder.recipe"},
    {"name": "the-mapper-without-a-recipe", "base": "wells-grid", "set": [[["folder", "writer", "name"], "ophiolite-mapper"]], "code": "recipe-writer", "path": "$.folder.writer.name"},
    {"name": "a-path-listed-twice", "base": "recipe-wells", "set": [[["folder", "files", 3, "path"], "originals/wells.csv"]], "code": "path-repeated", "path": "$.folder.files[3].path"},
    {"name": "a-path-an-asset-lists", "base": "recipe-wells", "set": [[["assets"], [{"files": [{"path": "originals/wells.csv"}]}]]], "code": "path-in-asset", "path": "$.folder.files[1].path"},
    {"name": "an-original-as-json", "base": "recipe-wells", "set": [[["folder", "files", 1, "media_type"], "application/json"]], "code": "media-type", "path": "$.folder.files[1].media_type"},
    {"name": "a-grid-as-parquet", "base": "wells-grid", "set": [[["folder", "files", 1, "media_type"], "application/vnd.apache.parquet"]], "code": "media-type", "path": "$.folder.files[1].media_type"},
    {"name": "a-representation-without-its-asset", "base": "recipe-wells", "set": [[["folder", "files", 2, "role"], "representation"]], "code": "asset-missing", "path": "$.folder.files[2].asset"},
    {"name": "a-representation-of-no-asset", "base": "recipe-wells", "set": [[["folder", "files", 2, "role"], "representation"], [["folder", "files", 2, "asset"], 0]], "code": "asset-unknown", "path": "$.folder.files[2].asset"},
    {"name": "a-second-lineage", "base": "recipe-wells", "set": [[["folder", "files", 4], {"path": "osdu/manifest.json", "role": "lineage-prov", "media_type": "application/json", "asset": null, "sha256": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "bytes": 10}]], "code": "role-repeated", "path": "$.folder.files[4]"},
    {"name": "the-lineage-at-another-path", "base": "recipe-wells", "set": [[["folder", "files", 3, "path"], "osdu/manifest.json"]], "code": "role-path", "path": "$.folder.files[3].path"},
    {"name": "an-original-of-an-asset", "base": "recipe-wells", "set": [[["folder", "files", 1, "asset"], 0]], "code": "asset-misplaced", "path": "$.folder.files[1].asset"},
    {"name": "the-mapper-without-lineage", "base": "recipe-wells", "delete": [["folder", "files", 3]], "code": "role-count", "path": "$.folder.files:lineage-prov"},
    {"name": "one-identity-table", "base": "wells-grid", "set": [[["folder", "files", 2], {"path": "identity/entities.parquet", "role": "identity-entities", "media_type": "application/vnd.apache.parquet", "asset": null, "sha256": "a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2", "bytes": 10}]], "code": "identity-partial", "path": "$.folder.files"},
    {"name": "the-recipe-digest-differs", "base": "recipe-wells", "set": [[["folder", "recipe", "sha256"], "c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1"]], "code": "recipe-digest", "path": "$.folder.recipe.sha256"},
