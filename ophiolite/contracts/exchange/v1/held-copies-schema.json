{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/exchange/v1/held-copies-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.held-copies/1",
    "version": "1.2.0",
    "lifecycle": "supported"
  },
  "$defs": {
    "HeldCopy": {
      "additionalProperties": false,
      "properties": {
        "copy": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Copy",
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/HeldCopyItem"
        },
        "application": {
          "anyOf": [
            {
              "pattern": "^(application:[a-z0-9._-]{1,128}|script)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Application"
        },
        "person": {
          "$ref": "#/$defs/HeldCopyPerson"
        },
        "key": {
          "default": null,
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/HeldCopyVersion"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "stays",
                "follows"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mode"
        },
        "state": {
          "enum": [
            "current",
            "behind",
            "no-longer-readable"
          ],
          "title": "State",
          "type": "string"
        },
        "behind": {
          "$ref": "#/$defs/HeldCopyBehind",
          "default": null
        },
        "reported": {
          "$ref": "#/$defs/HeldCopyReported",
          "default": null
        }
      },
      "required": [
        "copy",
        "item",
        "application",
        "person",
        "version",
        "mode",
        "state"
      ],
      "title": "HeldCopy",
      "type": "object"
    },
    "HeldCopyBehind": {
      "additionalProperties": false,
      "description": "The item's versions newer than the held one that the reader may read, and the head.",
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "newest": {
          "$ref": "#/$defs/HeldCopyNewest"
        }
      },
      "required": [
        "count",
        "newest"
      ],
      "title": "HeldCopyBehind",
      "type": "object"
    },
    "HeldCopyHost": {
      "additionalProperties": false,
      "description": "The host application and release named in the report request's own X-Ophiolite-Client header.",
      "properties": {
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "HeldCopyHost",
      "type": "object"
    },
    "HeldCopyItem": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "name",
        "kind"
      ],
      "title": "HeldCopyItem",
      "type": "object"
    },
    "HeldCopyNewest": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "author": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "at": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "author",
        "at"
      ],
      "title": "HeldCopyNewest",
      "type": "object"
    },
    "HeldCopyPerson": {
      "additionalProperties": false,
      "description": "Who the copy belongs to, as this reader may see it; a name only beside `you` or `named`.",
      "properties": {
        "shown": {
          "enum": [
            "you",
            "named",
            "a-member"
          ],
          "title": "Shown",
          "type": "string"
        },
        "name": {
          "default": null,
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "shown"
      ],
      "title": "HeldCopyPerson",
      "type": "object"
    },
    "HeldCopyReported": {
      "additionalProperties": false,
      "description": "E185 s2c (D-4): the holder's latest report of its connector's record, as the connector reported it (`as` is\nalways `reported`: the server states nothing of its own). `checked`: whether the host release is in the record's\nchecked list; `host`: null when the report named none.",
      "properties": {
        "connector": {
          "enum": [
            "opendtect",
            "qgis"
          ],
          "title": "Connector",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeldCopyHost"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked": {
          "title": "Checked",
          "type": "boolean"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/HeldCopyReportedRow"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "reported_at": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
          "title": "Reported At",
          "type": "string"
        },
        "as": {
          "const": "reported",
          "title": "As",
          "type": "string"
        }
      },
      "required": [
        "connector",
        "host",
        "checked",
        "rows",
        "reported_at",
        "as"
      ],
      "title": "HeldCopyReported",
      "type": "object"
    },
    "HeldCopyReportedRow": {
      "additionalProperties": false,
      "description": "One row of the connector's host-qualification record as the connector reported it.",
      "properties": {
        "row": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 /._-]{0,63}$",
          "title": "Row",
          "type": "string"
        },
        "availability": {
          "enum": [
            "supported",
            "refused"
          ],
          "title": "Availability",
          "type": "string"
        },
        "evidence": {
          "enum": [
            "proven",
            "unproven"
          ],
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "row",
        "availability",
        "evidence"
      ],
      "title": "HeldCopyReportedRow",
      "type": "object"
    },
    "HeldCopyVersion": {
      "additionalProperties": false,
      "description": "The version the copy last confirmed: `since` its first confirmation after its last different revision,\n`confirmed_at` the latest.",
      "properties": {
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "how": {
          "enum": [
            "got",
            "sent"
          ],
          "title": "How",
          "type": "string"
        },
        "confirmed_at": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
          "title": "Confirmed At",
          "type": "string"
        },
        "since": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
          "title": "Since",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/Sender",
          "default": null
        }
      },
      "required": [
        "revision",
        "how",
        "confirmed_at",
        "since"
      ],
      "title": "HeldCopyVersion",
      "type": "object"
    },
    "Sender": {
      "additionalProperties": false,
      "description": "What a version says sent it: a report, never a proof; no access, trust or verification decision reads it.",
      "else": {
        "if": {
          "properties": {
            "state": {
              "const": "not recorded"
            }
          },
          "required": [
            "state"
          ]
        },
        "properties": {
          "client": {
            "type": "null"
          },
          "host": {
            "type": "null"
          }
        },
        "then": {
          "properties": {
            "transport": {
              "type": "null"
            },
            "accepted_as": {
              "type": "null"
            }
          }
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "reported"
          }
        },
        "required": [
          "state"
        ]
      },
      "properties": {
        "schema": {
          "const": "ophiolite.sender/1",
          "title": "Schema",
          "type": "string"
        },
        "state": {
          "enum": [
            "reported",
            "not reported",
            "not recorded"
          ],
          "title": "State",
          "type": "string"
        },
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/SenderClient"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/SenderHost"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transport"
        },
        "accepted_as": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accepted As"
        }
      },
      "required": [
        "schema",
        "state",
        "client",
        "host",
        "transport",
        "accepted_as"
      ],
      "then": {
        "properties": {
          "client": {
            "type": "object"
          }
        }
      },
      "title": "Sender",
      "type": "object"
    },
    "SenderClient": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "product",
        "version"
      ],
      "title": "SenderClient",
      "type": "object"
    },
    "SenderHost": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "SenderHost",
      "type": "object"
    },
    "HoldersRequest": {
      "additionalProperties": false,
      "description": "The body of `exchange/holders`: the project (equal to the path's), an item or the whole project, and a page.",
      "properties": {
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "item": {
          "default": null,
          "maxLength": 512,
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "limit": {
          "default": 200,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "default": null,
          "maxLength": 1024,
          "minLength": 1,
          "title": "Cursor",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "HoldersRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "item": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Item"
    },
    "as_of": {
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
      "title": "As Of",
      "type": "string"
    },
    "complete_since": {
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
      "title": "Complete Since",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/HeldCopy"
      },
      "maxItems": 500,
      "title": "Rows",
      "type": "array"
    },
    "next": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next"
    }
  },
  "required": [
    "project",
    "item",
    "as_of",
    "complete_since",
    "rows",
    "next"
  ],
  "title": "HeldCopies",
  "type": "object"
}
