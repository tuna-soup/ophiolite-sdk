{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/profile-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.contract-profile/1",
    "version": "1.5.0",
    "lifecycle": "preview"
  },
  "title": "ContractProfile",
  "description": "A profile document under profiles/v1/. A profile is a versioned id naming a bounded meaning of bytes; the registry index is the closed membership list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "lifecycle",
    "display_name",
    "description"
  ],
  "properties": {
    "schema": {
      "const": "ophiolite.contract-profile/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
      "maxLength": 128
    },
    "kind": {
      "enum": [
        "source",
        "normalized"
      ]
    },
    "lifecycle": {
      "enum": [
        "preview",
        "supported",
        "deprecated"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "serves": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$"
      }
    },
    "payload_schema": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$"
    },
    "connector": {
      "$ref": "#/$defs/ConnectorSemantics"
    },
    "role": {
      "enum": [
        "artifact",
        "normalized"
      ]
    },
    "media_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "normalized_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$"
    },
    "context_schema": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$"
    },
    "recipe_schema": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
      "description": "E23a: the import-recipe schema that reads this source profile."
    },
    "representation_rules": {
      "$ref": "#/$defs/RepresentationRules"
    },
    "interpretation": {
      "$ref": "#/$defs/InterpretationIdentity"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$"
      }
    },
    "mapped_from": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$"
      }
    },
    "table_target": {
      "description": "E86: the table target this profile carries (a registered ophiolite.table-target document id), or why it carries none.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ophiolite\\.table-target/[a-z][a-z0-9-]*/[0-9]+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "none"
          ],
          "properties": {
            "none": {
              "enum": [
                "normalized-form",
                "read-by-recipe",
                "not-a-table"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "ConnectorSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_profile",
        "source_schema",
        "mapping_version",
        "history"
      ],
      "properties": {
        "scientific_profile": {
          "type": "string",
          "minLength": 1
        },
        "source_schema": {
          "type": "string",
          "minLength": 1
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RepresentationRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind_by_origin",
        "normalized",
        "total"
      ],
      "properties": {
        "artifact_kind_by_origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source-reference",
            "retained-capture",
            "managed-derived"
          ],
          "properties": {
            "source-reference": {
              "enum": [
                "original",
                "captured-result",
                "derived-artifact"
              ]
            },
            "retained-capture": {
              "enum": [
                "original",
                "captured-result",
                "derived-artifact"
              ]
            },
            "managed-derived": {
              "enum": [
                "original",
                "captured-result",
                "derived-artifact"
              ]
            }
          }
        },
        "normalized": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "InterpretationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader",
        "parsing_policy",
        "mapping"
      ],
      "properties": {
        "reader": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*/[0-9]+$"
        },
        "parsing_policy": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*/[0-9]+$"
        },
        "mapping": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*/[0-9]+$"
        }
      }
    }
  }
}
