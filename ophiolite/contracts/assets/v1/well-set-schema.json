{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/well-set-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.well-set/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader; E56: feature_files for feature sets).",
      "properties": {
        "reader": {
          "enum": [
            "asset_connectors.typed_reader/1",
            "asset_connectors.feature_files/1"
          ],
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1",
            "well-location/1",
            "wavelet/1",
            "model-section/1",
            "seismic-section/1",
            "time-depth/1",
            "feature-set/1",
            "well-path/1",
            "well-set/1",
            "well-residual/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    },
    "WellSetContext": {
      "additionalProperties": false,
      "description": "The counts of a well set: its members, those with a trajectory and those without (typed-context 1.8.0).",
      "properties": {
        "type": {
          "const": "well-set",
          "title": "Type",
          "type": "string"
        },
        "count": {
          "maximum": 29,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "with_trajectory": {
          "maximum": 29,
          "minimum": 0,
          "title": "With Trajectory",
          "type": "integer"
        },
        "without_trajectory": {
          "maximum": 29,
          "minimum": 0,
          "title": "Without Trajectory",
          "type": "integer"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "count",
        "with_trajectory",
        "without_trajectory",
        "fidelity"
      ],
      "title": "WellSetContext",
      "type": "object"
    },
    "WellSetDepthReference": {
      "additionalProperties": false,
      "description": "What measured depth is measured from (name, such as KB), at `elevation` metres above `datum`, positive up.",
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "elevation": {
          "description": "Metres above the datum, positive up.",
          "title": "Elevation",
          "type": "number"
        },
        "datum": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Datum",
          "type": "string"
        }
      },
      "required": [
        "name",
        "elevation",
        "datum"
      ],
      "title": "WellSetDepthReference",
      "type": "object"
    },
    "WellSetFrame": {
      "additionalProperties": false,
      "description": "Where a member's trajectory starts and how it is oriented, as its author states it; nothing is looked up.",
      "properties": {
        "crs": {
          "pattern": "^EPSG:[0-9]{4,6}$",
          "title": "Crs",
          "type": "string"
        },
        "wellhead": {
          "$ref": "#/$defs/WellSetPoint"
        },
        "depth_reference": {
          "$ref": "#/$defs/WellSetDepthReference"
        },
        "north": {
          "$ref": "#/$defs/WellSetNorth"
        },
        "tie_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/WellSetTieIn"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "description": "Shown, never parsed.",
          "maxLength": 200,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "crs",
        "wellhead",
        "depth_reference",
        "north",
        "tie_in",
        "source"
      ],
      "title": "WellSetFrame",
      "type": "object"
    },
    "WellSetMember": {
      "additionalProperties": false,
      "description": "A wellbore under its well, with one exact trajectory revision and its frame, or neither.",
      "properties": {
        "well": {
          "pattern": "^well-[0-9a-f]{32}$",
          "title": "Well",
          "type": "string"
        },
        "wellbore": {
          "pattern": "^wellbore-[0-9a-f]{32}$",
          "title": "Wellbore",
          "type": "string"
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/WellSetTrajectory"
            },
            {
              "type": "null"
            }
          ]
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/WellSetFrame"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "well",
        "wellbore",
        "trajectory",
        "frame"
      ],
      "title": "WellSetMember",
      "type": "object"
    },
    "WellSetNorth": {
      "additionalProperties": false,
      "description": "The survey's azimuth basis and the signed rotation, in degrees, that carries it to the frame's grid (E119a 4-6).",
      "properties": {
        "survey_basis": {
          "pattern": "^(true-north|grid:EPSG:[0-9]{4,6})$",
          "title": "Survey Basis",
          "type": "string"
        },
        "rotation_deg": {
          "maximum": 10,
          "minimum": -10,
          "title": "Rotation Deg",
          "type": "number"
        }
      },
      "required": [
        "survey_basis",
        "rotation_deg"
      ],
      "title": "WellSetNorth",
      "type": "object"
    },
    "WellSetPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "WellSetPoint",
      "type": "object"
    },
    "WellSetTieIn": {
      "additionalProperties": false,
      "description": "The first station's position when it is below the wellhead: measured depth (above 0), TVD, east and north offsets.",
      "properties": {
        "md": {
          "exclusiveMinimum": 0,
          "title": "Md",
          "type": "number"
        },
        "tvd": {
          "title": "Tvd",
          "type": "number"
        },
        "east": {
          "title": "East",
          "type": "number"
        },
        "north": {
          "title": "North",
          "type": "number"
        }
      },
      "required": [
        "md",
        "tvd",
        "east",
        "north"
      ],
      "title": "WellSetTieIn",
      "type": "object"
    },
    "WellSetTrajectory": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "revision"
      ],
      "title": "WellSetTrajectory",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "E119a: a well set as uploaded (label and members in order); private to its author in this version.",
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.well-set/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/WellSetContext"
    },
    "label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/WellSetMember"
      },
      "maxItems": 29,
      "minItems": 1,
      "title": "Members",
      "type": "array"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "label",
    "members"
  ],
  "title": "WellSet",
  "type": "object"
}
