{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/attachment-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.attachment/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "AttachmentActor": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "job": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "agent": {
            "type": "null"
          }
        },
        "required": [
          "agent"
        ]
      },
      "properties": {
        "person": {
          "description": "The person who acted, always",
          "maxLength": 64,
          "minLength": 1,
          "title": "Person",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The assistant that acted for the person under an approved job; null for the person's own act",
          "title": "Agent"
        },
        "job": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The approved job the assistant acted under; null exactly when agent is",
          "title": "Job"
        }
      },
      "required": [
        "person",
        "agent",
        "job"
      ],
      "then": {
        "properties": {
          "job": {
            "type": "null"
          }
        }
      },
      "title": "AttachmentActor",
      "type": "object"
    },
    "AttachmentVersion": {
      "additionalProperties": false,
      "description": "The one item version the figure belongs to; it never changes.",
      "properties": {
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "revision"
      ],
      "title": "AttachmentVersion",
      "type": "object"
    },
    "AttachmentWithdrawal": {
      "additionalProperties": false,
      "description": "Who withdrew the figure (a person, never an assistant), when, and why; the record stays.",
      "if": {
        "required": [
          "by"
        ]
      },
      "properties": {
        "by": {
          "$ref": "#/$defs/AttachmentActor"
        },
        "at": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
          "title": "At",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "by",
        "at",
        "reason"
      ],
      "then": {
        "properties": {
          "by": {
            "properties": {
              "agent": {
                "type": "null"
              }
            }
          }
        }
      },
      "title": "AttachmentWithdrawal",
      "type": "object"
    },
    "Sender": {
      "additionalProperties": false,
      "description": "What a version says sent it: a report, never a proof; no access, trust or verification decision reads it.",
      "else": {
        "if": {
          "properties": {
            "state": {
              "const": "not recorded"
            }
          },
          "required": [
            "state"
          ]
        },
        "properties": {
          "client": {
            "type": "null"
          },
          "host": {
            "type": "null"
          }
        },
        "then": {
          "properties": {
            "transport": {
              "type": "null"
            },
            "accepted_as": {
              "type": "null"
            }
          }
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "reported"
          }
        },
        "required": [
          "state"
        ]
      },
      "properties": {
        "schema": {
          "const": "ophiolite.sender/1",
          "title": "Schema",
          "type": "string"
        },
        "state": {
          "enum": [
            "reported",
            "not reported",
            "not recorded"
          ],
          "title": "State",
          "type": "string"
        },
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/SenderClient"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/SenderHost"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transport"
        },
        "accepted_as": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accepted As"
        }
      },
      "required": [
        "schema",
        "state",
        "client",
        "host",
        "transport",
        "accepted_as"
      ],
      "then": {
        "properties": {
          "client": {
            "type": "object"
          }
        }
      },
      "title": "Sender",
      "type": "object"
    },
    "SenderClient": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "product",
        "version"
      ],
      "title": "SenderClient",
      "type": "object"
    },
    "SenderHost": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "SenderHost",
      "type": "object"
    },
    "Attachment": {
      "additionalProperties": false,
      "description": "One figure bound once to one item version: a file served under that version's access, never as a page.",
      "else": {
        "properties": {
          "withdrawal": {
            "type": "null"
          },
          "sender": {
            "properties": {
              "accepted_as": {
                "type": "null"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "withdrawn"
          }
        },
        "required": [
          "state"
        ]
      },
      "properties": {
        "schema": {
          "const": "ophiolite.attachment/1",
          "title": "Schema",
          "type": "string"
        },
        "attachment_id": {
          "description": "Minted by the server at random; never derived from the bytes",
          "pattern": "^[0-9a-f]{32}$",
          "title": "Attachment Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/AttachmentVersion"
        },
        "label": {
          "description": "As people name the figure; compared exactly",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
          "title": "Label",
          "type": "string"
        },
        "media_type": {
          "description": "Decided from the bytes, never from the name",
          "enum": [
            "image/png",
            "image/jpeg",
            "application/pdf"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "bytes": {
          "description": "The stored length; the deployment's bound is at most the ceiling",
          "maximum": 16777216,
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "file_name": {
          "anyOf": [
            {
              "description": "The name the sender gave, kept as text; never placed in a header",
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Name"
        },
        "added_by": {
          "$ref": "#/$defs/AttachmentActor"
        },
        "sender": {
          "$ref": "#/$defs/Sender",
          "description": "What the request that added the figure said sent it (ophiolite.sender/1); accepted_as is always null"
        },
        "added_at": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
          "title": "Added At",
          "type": "string"
        },
        "state": {
          "enum": [
            "current",
            "withdrawn"
          ],
          "title": "State",
          "type": "string"
        },
        "withdrawal": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttachmentWithdrawal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "attachment_id",
        "project_id",
        "version",
        "label",
        "media_type",
        "bytes",
        "sha256",
        "file_name",
        "added_by",
        "sender",
        "added_at",
        "state",
        "withdrawal"
      ],
      "then": {
        "properties": {
          "withdrawal": {
            "type": "object"
          },
          "sender": {
            "properties": {
              "accepted_as": {
                "type": "null"
              }
            }
          }
        }
      },
      "title": "Attachment",
      "type": "object"
    },
    "AttachmentList": {
      "additionalProperties": false,
      "description": "One version's figures, newest first in the order they were added (no two tie).",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "maxItems": 200,
          "title": "Attachments",
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next"
        }
      },
      "required": [
        "attachments",
        "next"
      ],
      "title": "AttachmentList",
      "type": "object"
    },
    "AttachmentAddRequest": {
      "additionalProperties": false,
      "description": "`attachments/add`: one file, base64, for one version the caller may add to and read.",
      "properties": {
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "command_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "label": {
          "description": "As people name the figure; compared exactly",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
          "title": "Label",
          "type": "string"
        },
        "file_name": {
          "anyOf": [
            {
              "description": "The name the sender gave, kept as text; never placed in a header",
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Name"
        },
        "content": {
          "description": "The file's bytes, base64 (RFC 4648, padded)",
          "maxLength": 22369624,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "command_id",
        "asset_id",
        "revision",
        "label",
        "content"
      ],
      "title": "AttachmentAddRequest",
      "type": "object"
    },
    "AttachmentListRequest": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cursor"
        }
      },
      "required": [
        "project_id",
        "asset_id",
        "revision"
      ],
      "title": "AttachmentListRequest",
      "type": "object"
    },
    "AttachmentReadRequest": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "attachment_id": {
          "description": "Minted by the server at random; never derived from the bytes",
          "pattern": "^[0-9a-f]{32}$",
          "title": "Attachment Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "attachment_id"
      ],
      "title": "AttachmentReadRequest",
      "type": "object"
    },
    "AttachmentWithdrawRequest": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "command_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "attachment_id": {
          "description": "Minted by the server at random; never derived from the bytes",
          "pattern": "^[0-9a-f]{32}$",
          "title": "Attachment Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "command_id",
        "attachment_id",
        "reason"
      ],
      "title": "AttachmentWithdrawRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One figure bound once to one item version: a file served under that version's access, never as a page.",
  "else": {
    "properties": {
      "withdrawal": {
        "type": "null"
      },
      "sender": {
        "properties": {
          "accepted_as": {
            "type": "null"
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "state": {
        "const": "withdrawn"
      }
    },
    "required": [
      "state"
    ]
  },
  "properties": {
    "schema": {
      "const": "ophiolite.attachment/1",
      "title": "Schema",
      "type": "string"
    },
    "attachment_id": {
      "description": "Minted by the server at random; never derived from the bytes",
      "pattern": "^[0-9a-f]{32}$",
      "title": "Attachment Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/AttachmentVersion"
    },
    "label": {
      "description": "As people name the figure; compared exactly",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
      "title": "Label",
      "type": "string"
    },
    "media_type": {
      "description": "Decided from the bytes, never from the name",
      "enum": [
        "image/png",
        "image/jpeg",
        "application/pdf"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "bytes": {
      "description": "The stored length; the deployment's bound is at most the ceiling",
      "maximum": 16777216,
      "minimum": 1,
      "title": "Bytes",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "file_name": {
      "anyOf": [
        {
          "description": "The name the sender gave, kept as text; never placed in a header",
          "maxLength": 255,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "File Name"
    },
    "added_by": {
      "$ref": "#/$defs/AttachmentActor"
    },
    "sender": {
      "$ref": "#/$defs/Sender",
      "description": "What the request that added the figure said sent it (ophiolite.sender/1); accepted_as is always null"
    },
    "added_at": {
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?Z$",
      "title": "Added At",
      "type": "string"
    },
    "state": {
      "enum": [
        "current",
        "withdrawn"
      ],
      "title": "State",
      "type": "string"
    },
    "withdrawal": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttachmentWithdrawal"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "attachment_id",
    "project_id",
    "version",
    "label",
    "media_type",
    "bytes",
    "sha256",
    "file_name",
    "added_by",
    "sender",
    "added_at",
    "state",
    "withdrawal"
  ],
  "then": {
    "properties": {
      "withdrawal": {
        "type": "object"
      },
      "sender": {
        "properties": {
          "accepted_as": {
            "type": "null"
          }
        }
      }
    }
  },
  "title": "Attachment",
  "type": "object"
}
