{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/polyline-set-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.polyline-set/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "PolylineContext": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "xy_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Xy Unit",
          "type": "string"
        },
        "z_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Z Unit",
          "type": "string"
        },
        "z_meaning": {
          "enum": [
            "depth",
            "elevation",
            "time",
            "unknown"
          ],
          "title": "Z Meaning",
          "type": "string"
        },
        "positive": {
          "enum": [
            "up",
            "down",
            "unknown"
          ],
          "title": "Positive",
          "type": "string"
        },
        "vertical_datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Vertical Datum",
          "type": "string"
        },
        "x_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "X Range",
          "type": "array"
        },
        "y_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Y Range",
          "type": "array"
        },
        "z_range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Z Range"
        },
        "attributes": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Attributes",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        },
        "type": {
          "const": "polyline-set",
          "title": "Type",
          "type": "string"
        },
        "sticks": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Sticks",
          "type": "integer"
        },
        "points": {
          "maximum": 200000,
          "minimum": 2,
          "title": "Points",
          "type": "integer"
        }
      },
      "required": [
        "crs",
        "xy_unit",
        "z_unit",
        "z_meaning",
        "positive",
        "vertical_datum",
        "x_range",
        "y_range",
        "z_range",
        "attributes",
        "fidelity",
        "type",
        "sticks",
        "points"
      ],
      "title": "PolylineContext",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Stick": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/XYZ"
          },
          "maxItems": 200000,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "index",
        "points"
      ],
      "title": "Stick",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader).",
      "properties": {
        "reader": {
          "const": "asset_connectors.typed_reader/1",
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    },
    "XYZ": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "XYZ",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.polyline-set/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/PolylineContext"
    },
    "sticks": {
      "items": {
        "$ref": "#/$defs/Stick"
      },
      "maxItems": 20000,
      "minItems": 1,
      "title": "Sticks",
      "type": "array"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "sticks"
  ],
  "title": "PolylineSet",
  "type": "object"
}
