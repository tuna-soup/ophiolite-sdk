{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/typed-context-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.typed-context/1",
    "version": "1.3.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "GridContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "regular-grid-surface",
          "title": "Type",
          "type": "string"
        },
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "xy_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Xy Unit",
          "type": "string"
        },
        "z_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Z Unit",
          "type": "string"
        },
        "z_meaning": {
          "enum": [
            "depth",
            "elevation",
            "time",
            "unknown"
          ],
          "title": "Z Meaning",
          "type": "string"
        },
        "positive": {
          "enum": [
            "up",
            "down",
            "unknown"
          ],
          "title": "Positive",
          "type": "string"
        },
        "vertical_datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Vertical Datum",
          "type": "string"
        },
        "registration": {
          "enum": [
            "corner",
            "center"
          ],
          "title": "Registration",
          "type": "string"
        },
        "row_order": {
          "const": "north-to-south",
          "title": "Row Order",
          "type": "string"
        },
        "ncols": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Ncols",
          "type": "integer"
        },
        "nrows": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Nrows",
          "type": "integer"
        },
        "cell_size": {
          "exclusiveMinimum": 0,
          "title": "Cell Size",
          "type": "number"
        },
        "x_first_center": {
          "title": "X First Center",
          "type": "number"
        },
        "y_first_center": {
          "title": "Y First Center",
          "type": "number"
        },
        "missing_count": {
          "maximum": 262144,
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "value_range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Range"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "crs",
        "xy_unit",
        "z_unit",
        "z_meaning",
        "positive",
        "vertical_datum",
        "registration",
        "row_order",
        "ncols",
        "nrows",
        "cell_size",
        "x_first_center",
        "y_first_center",
        "missing_count",
        "value_range",
        "fidelity"
      ],
      "title": "GridContext",
      "type": "object"
    },
    "LineRange": {
      "additionalProperties": false,
      "properties": {
        "first": {
          "title": "First",
          "type": "integer"
        },
        "last": {
          "title": "Last",
          "type": "integer"
        },
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "first",
        "last",
        "step",
        "count"
      ],
      "title": "LineRange",
      "type": "object"
    },
    "MeshContext": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "xy_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Xy Unit",
          "type": "string"
        },
        "z_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Z Unit",
          "type": "string"
        },
        "z_meaning": {
          "enum": [
            "depth",
            "elevation",
            "time",
            "unknown"
          ],
          "title": "Z Meaning",
          "type": "string"
        },
        "positive": {
          "enum": [
            "up",
            "down",
            "unknown"
          ],
          "title": "Positive",
          "type": "string"
        },
        "vertical_datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Vertical Datum",
          "type": "string"
        },
        "x_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "X Range",
          "type": "array"
        },
        "y_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Y Range",
          "type": "array"
        },
        "z_range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Z Range"
        },
        "attributes": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Attributes",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        },
        "type": {
          "const": "triangulated-surface",
          "title": "Type",
          "type": "string"
        },
        "vertex_count": {
          "maximum": 200000,
          "minimum": 3,
          "title": "Vertex Count",
          "type": "integer"
        },
        "triangle_count": {
          "maximum": 400000,
          "minimum": 1,
          "title": "Triangle Count",
          "type": "integer"
        },
        "missing_z_count": {
          "maximum": 200000,
          "minimum": 0,
          "title": "Missing Z Count",
          "type": "integer"
        }
      },
      "required": [
        "crs",
        "xy_unit",
        "z_unit",
        "z_meaning",
        "positive",
        "vertical_datum",
        "x_range",
        "y_range",
        "z_range",
        "attributes",
        "fidelity",
        "type",
        "vertex_count",
        "triangle_count",
        "missing_z_count"
      ],
      "title": "MeshContext",
      "type": "object"
    },
    "PointContext": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "xy_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Xy Unit",
          "type": "string"
        },
        "z_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Z Unit",
          "type": "string"
        },
        "z_meaning": {
          "enum": [
            "depth",
            "elevation",
            "time",
            "unknown"
          ],
          "title": "Z Meaning",
          "type": "string"
        },
        "positive": {
          "enum": [
            "up",
            "down",
            "unknown"
          ],
          "title": "Positive",
          "type": "string"
        },
        "vertical_datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Vertical Datum",
          "type": "string"
        },
        "x_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "X Range",
          "type": "array"
        },
        "y_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Y Range",
          "type": "array"
        },
        "z_range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Z Range"
        },
        "attributes": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Attributes",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        },
        "type": {
          "const": "point-set",
          "title": "Type",
          "type": "string"
        },
        "count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "z_provided": {
          "title": "Z Provided",
          "type": "boolean"
        },
        "missing_z_count": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Missing Z Count",
          "type": "integer"
        }
      },
      "required": [
        "crs",
        "xy_unit",
        "z_unit",
        "z_meaning",
        "positive",
        "vertical_datum",
        "x_range",
        "y_range",
        "z_range",
        "attributes",
        "fidelity",
        "type",
        "count",
        "z_provided",
        "missing_z_count"
      ],
      "title": "PointContext",
      "type": "object"
    },
    "PolylineContext": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
