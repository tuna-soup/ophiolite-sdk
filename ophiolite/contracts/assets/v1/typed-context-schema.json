      "required": [
        "type",
        "crs",
        "elevation_reference",
        "fidelity"
      ],
      "title": "WellLocationContext",
      "type": "object"
    },
    "XY": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "XY",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The context schema shared by the typed profiles.",
  "properties": {
    "context": {
      "discriminator": {
        "mapping": {
          "point-set": "#/$defs/PointContext",
          "polyline-set": "#/$defs/PolylineContext",
          "regular-grid-surface": "#/$defs/GridContext",
          "seismic-volume": "#/$defs/SeismicContext",
          "trajectory": "#/$defs/TrajectoryContext",
          "triangulated-surface": "#/$defs/MeshContext",
          "well-location": "#/$defs/WellLocationContext",
          "well-tops": "#/$defs/TopsContext"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TopsContext"
        },
        {
          "$ref": "#/$defs/TrajectoryContext"
        },
        {
          "$ref": "#/$defs/GridContext"
        },
        {
          "$ref": "#/$defs/MeshContext"
        },
        {
          "$ref": "#/$defs/PointContext"
        },
        {
          "$ref": "#/$defs/PolylineContext"
        },
        {
          "$ref": "#/$defs/SeismicContext"
        },
        {
          "$ref": "#/$defs/WellLocationContext"
        }
      ],
      "title": "Context"
    }
  },
  "required": [
    "context"
  ],
  "title": "TypedContext",
  "type": "object"
}
