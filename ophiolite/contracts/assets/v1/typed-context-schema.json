              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Z Range"
        },
        "attributes": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
            "type": "string"
          },
          "maxItems": 16,
