        "tvd_provided",
        "md_range",
        "fidelity"
      ],
      "title": "TopsContext",
      "type": "object"
    },
    "TrajectoryContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "trajectory",
          "title": "Type",
          "type": "string"
        },
        "depth_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Depth Unit",
          "type": "string"
        },
        "angle_unit": {
          "const": "deg",
          "title": "Angle Unit",
          "type": "string"
        },
        "azimuth_reference": {
          "enum": [
            "true-north",
            "grid-north",
            "magnetic-north",
            "unknown"
          ],
          "title": "Azimuth Reference",
          "type": "string"
        },
        "depth_datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Depth Datum",
          "type": "string"
        },
        "count": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "missing_angle_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Missing Angle Count",
          "type": "integer"
        },
        "tvd_provided": {
          "title": "Tvd Provided",
          "type": "boolean"
        },
        "md_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Md Range",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "depth_unit",
        "angle_unit",
        "azimuth_reference",
        "depth_datum",
        "count",
        "missing_angle_count",
        "tvd_provided",
        "md_range",
        "fidelity"
      ],
      "title": "TrajectoryContext",
      "type": "object"
    },
    "WellLocationContext": {
      "additionalProperties": false,
      "description": "E29: one well's surface point as its file states it (typed-context 1.3.0).",
      "properties": {
        "type": {
          "const": "well-location",
          "title": "Type",
          "type": "string"
        },
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|OGC:CRS84|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "elevation_reference": {
          "enum": [
            "unknown",
            "GL",
            "KB",
            "MSL"
          ],
          "title": "Elevation Reference",
          "type": "string"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
