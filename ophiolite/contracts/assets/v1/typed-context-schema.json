    "SeismicContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "seismic-volume",
          "title": "Type",
          "type": "string"
        },
        "format": {
          "enum": [
            "IBM 4-byte floating point",
            "IEEE 4-byte floating point"
          ],
          "title": "Format",
          "type": "string"
        },
        "format_code": {
          "enum": [
            1,
            5
          ],
          "title": "Format Code",
          "type": "integer"
        },
        "segy_revision": {
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$",
          "title": "Segy Revision",
          "type": "string"
        },
        "traces": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Traces",
          "type": "integer"
        },
        "samples": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "trace_bytes": {
          "minimum": 244,
          "title": "Trace Bytes",
          "type": "integer"
        },
        "inline": {
          "$ref": "#/$defs/LineRange"
        },
        "crossline": {
          "$ref": "#/$defs/LineRange"
        },
        "sample_interval": {
          "exclusiveMinimum": 0,
          "title": "Sample Interval",
          "type": "number"
        },
        "sample_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Sample Unit",
          "type": "string"
        },
        "first_sample": {
          "title": "First Sample",
          "type": "number"
        },
        "z_domain": {
          "enum": [
            "time",
            "depth",
            "unknown"
          ],
          "title": "Z Domain",
          "type": "string"
        },
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Datum",
          "type": "string"
        },
        "first_cdp": {
          "$ref": "#/$defs/XY"
        },
        "last_cdp": {
          "$ref": "#/$defs/XY"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "format",
        "format_code",
        "segy_revision",
        "traces",
        "samples",
        "trace_bytes",
        "inline",
        "crossline",
        "sample_interval",
        "sample_unit",
        "first_sample",
        "z_domain",
        "crs",
        "datum",
        "first_cdp",
        "last_cdp",
        "fidelity"
      ],
      "title": "SeismicContext",
      "type": "object"
    },
    "TopsContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "well-tops",
          "title": "Type",
