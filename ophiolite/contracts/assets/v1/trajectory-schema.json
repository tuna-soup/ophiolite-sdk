{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/trajectory-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.trajectory/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Station": {
      "additionalProperties": false,
      "properties": {
        "md": {
          "title": "Md",
          "type": "number"
        },
        "inclination": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inclination"
        },
        "azimuth": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Azimuth"
        },
        "tvd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tvd"
        }
      },
      "required": [
        "md",
        "inclination",
        "azimuth",
        "tvd"
      ],
      "title": "Station",
      "type": "object"
    },
    "TrajectoryContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "trajectory",
          "title": "Type",
          "type": "string"
        },
        "depth_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Depth Unit",
          "type": "string"
        },
        "angle_unit": {
          "const": "deg",
          "title": "Angle Unit",
          "type": "string"
        },
        "azimuth_reference": {
          "enum": [
            "true-north",
            "grid-north",
            "magnetic-north",
            "unknown"
          ],
          "title": "Azimuth Reference",
          "type": "string"
        },
        "depth_datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Depth Datum",
          "type": "string"
        },
        "count": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "missing_angle_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Missing Angle Count",
          "type": "integer"
        },
        "tvd_provided": {
          "title": "Tvd Provided",
          "type": "boolean"
        },
        "md_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Md Range",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "depth_unit",
        "angle_unit",
        "azimuth_reference",
        "depth_datum",
        "count",
        "missing_angle_count",
        "tvd_provided",
        "md_range",
        "fidelity"
      ],
      "title": "TrajectoryContext",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader).",
      "properties": {
        "reader": {
          "const": "asset_connectors.typed_reader/1",
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.trajectory/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/TrajectoryContext"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/Station"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Stations",
      "type": "array"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "stations"
  ],
  "title": "Trajectory",
  "type": "object"
}
