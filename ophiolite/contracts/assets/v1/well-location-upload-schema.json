{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/well-location-upload-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.well-location-upload/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader).",
      "properties": {
        "reader": {
          "const": "asset_connectors.typed_reader/1",
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1",
            "well-location/1",
            "wavelet/1",
            "model-section/1",
            "seismic-section/1",
            "time-depth/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    },
    "WellLocationContext": {
      "additionalProperties": false,
      "description": "E29: one well's surface point as its file states it (typed-context 1.3.0).",
      "properties": {
        "type": {
          "const": "well-location",
          "title": "Type",
          "type": "string"
        },
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|OGC:CRS84|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "elevation_reference": {
          "enum": [
            "unknown",
            "GL",
            "KB",
            "MSL"
          ],
          "title": "Elevation Reference",
          "type": "string"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "crs",
        "elevation_reference",
        "fidelity"
      ],
      "title": "WellLocationContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "E29: the immutable normalized content of a well-location/1 file \u2014 one surface point in the CRS it states.\nNothing about where it came from or which well it locates: that is an of-entity association (WellLocation).",
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.well-location-upload/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/WellLocationContext"
    },
    "x": {
      "title": "X",
      "type": "number"
    },
    "y": {
      "title": "Y",
      "type": "number"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "x",
    "y"
  ],
  "title": "WellLocationUpload",
  "type": "object"
}
