{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/model-section-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.model-section/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "ModelSectionContext": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "time",
            "depth"
          ],
          "title": "Domain",
          "type": "string"
        },
        "first_sample": {
          "title": "First Sample",
          "type": "number"
        },
        "sample_interval": {
          "exclusiveMinimum": 0,
          "title": "Sample Interval",
          "type": "number"
        },
        "sample_unit": {
          "enum": [
            "s",
            "m"
          ],
          "title": "Sample Unit",
          "type": "string"
        },
        "samples": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "traces": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Traces",
          "type": "integer"
        },
        "horizontal": {
          "enum": [
            "distance",
            "trace-number"
          ],
          "title": "Horizontal",
          "type": "string"
        },
        "horizontal_first": {
          "title": "Horizontal First",
          "type": "number"
        },
        "horizontal_step": {
          "exclusiveMinimum": 0,
          "title": "Horizontal Step",
          "type": "number"
        },
        "horizontal_unit": {
          "anyOf": [
            {
              "const": "m",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Horizontal Unit"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        },
        "type": {
          "const": "model-section",
          "title": "Type",
          "type": "string"
        },
        "rock_count": {
          "maximum": 256,
          "minimum": 1,
          "title": "Rock Count",
          "type": "integer"
        },
        "velocity_unit": {
          "const": "m/s",
          "title": "Velocity Unit",
          "type": "string"
        },
        "density_unit": {
          "const": "kg/m3",
          "title": "Density Unit",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "first_sample",
        "sample_interval",
        "sample_unit",
        "samples",
        "traces",
        "horizontal",
        "horizontal_first",
        "horizontal_step",
        "horizontal_unit",
        "fidelity",
        "type",
        "rock_count",
        "velocity_unit",
        "density_unit"
      ],
      "title": "ModelSectionContext",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Rock": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "vp": {
          "exclusiveMinimum": 0,
          "title": "Vp",
          "type": "number"
        },
        "density": {
          "exclusiveMinimum": 0,
          "title": "Density",
          "type": "number"
        }
      },
      "required": [
        "index",
        "name",
        "vp",
        "density"
      ],
      "title": "Rock",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader).",
      "properties": {
        "reader": {
          "const": "asset_connectors.typed_reader/1",
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1",
            "well-location/1",
            "wavelet/1",
            "model-section/1",
            "seismic-section/1",
            "time-depth/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "E53: rocks (index, name, P-wave velocity m/s, density kg/m3) and a rock-index grid, one row per vertical sample.",
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.model-section/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/ModelSectionContext"
    },
    "rocks": {
      "items": {
        "$ref": "#/$defs/Rock"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Rocks",
      "type": "array"
    },
    "grid": {
      "items": {
        "items": {
          "minimum": 0,
          "type": "integer"
        },
        "type": "array"
      },
      "maxItems": 8192,
      "minItems": 1,
      "title": "Grid",
      "type": "array"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "rocks",
    "grid"
  ],
  "title": "ModelSection",
  "type": "object"
}
