{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/seismic-slice-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.seismic-slice/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "SampleMeaning": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "time",
            "depth",
            "unknown"
          ],
          "title": "Domain",
          "type": "string"
        },
        "unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Unit",
          "type": "string"
        },
        "first": {
          "title": "First",
          "type": "number"
        },
        "interval": {
          "exclusiveMinimum": 0,
          "title": "Interval",
          "type": "number"
        }
      },
      "required": [
        "domain",
        "unit",
        "first",
        "interval"
      ],
      "title": "SampleMeaning",
      "type": "object"
    },
    "SliceAxis": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "inline",
            "crossline",
            "sample"
          ],
          "title": "Name",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "title": "SliceAxis",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader).",
      "properties": {
        "reader": {
          "const": "asset_connectors.typed_reader/1",
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1",
            "well-location/1",
            "wavelet/1",
            "model-section/1",
            "seismic-section/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One slice of a seismic volume at an exact revision: exact samples (IBM converted exactly) and its\naxes; a slice is not the complete volume.",
  "properties": {
    "schema": {
      "const": "ophiolite.seismic-slice/1",
      "title": "Schema",
      "type": "string"
    },
    "representation": {
      "const": "slice",
      "title": "Representation",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "revision": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "axis": {
      "enum": [
        "inline",
        "crossline",
        "sample"
      ],
      "title": "Axis",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "integer"
    },
    "scope": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "rows": {
      "$ref": "#/$defs/SliceAxis"
    },
    "columns": {
      "$ref": "#/$defs/SliceAxis"
    },
    "sample": {
      "$ref": "#/$defs/SampleMeaning"
    },
    "values": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Values",
      "type": "array"
    },
    "chunks": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Chunks",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "representation",
    "asset_id",
    "revision",
    "source",
    "source_sha256",
    "interpretation",
    "axis",
    "label",
    "scope",
    "rows",
    "columns",
    "sample",
    "values",
    "chunks"
  ],
  "title": "SeismicSlice",
  "type": "object"
}
