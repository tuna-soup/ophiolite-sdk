{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/well-tops-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.well-tops/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Top": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "md": {
          "title": "Md",
          "type": "number"
        },
        "tvd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tvd"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "name",
        "md",
        "tvd",
        "source"
      ],
      "title": "Top",
      "type": "object"
    },
    "TopsContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "well-tops",
          "title": "Type",
          "type": "string"
        },
        "depth_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Depth Unit",
          "type": "string"
        },
        "depth_basis": {
          "enum": [
            "same-as-log",
            "other",
            "unknown"
          ],
          "title": "Depth Basis",
          "type": "string"
        },
        "count": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "tvd_provided": {
          "title": "Tvd Provided",
          "type": "boolean"
        },
        "md_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Md Range",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "depth_unit",
        "depth_basis",
        "count",
        "tvd_provided",
        "md_range",
        "fidelity"
      ],
      "title": "TopsContext",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader; E56: feature_files for feature sets).",
      "properties": {
        "reader": {
          "enum": [
            "asset_connectors.typed_reader/1",
            "asset_connectors.feature_files/1"
          ],
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1",
            "well-location/1",
            "wavelet/1",
            "model-section/1",
            "seismic-section/1",
            "time-depth/1",
            "feature-set/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.well-tops/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/TopsContext"
    },
    "tops": {
      "items": {
        "$ref": "#/$defs/Top"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Tops",
      "type": "array"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "tops"
  ],
  "title": "WellTops",
  "type": "object"
}
