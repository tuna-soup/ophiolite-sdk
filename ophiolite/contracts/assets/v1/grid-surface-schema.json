{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/grid-surface-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.regular-grid-surface/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "GridContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "regular-grid-surface",
          "title": "Type",
          "type": "string"
        },
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "xy_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Xy Unit",
          "type": "string"
        },
        "z_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Z Unit",
          "type": "string"
        },
        "z_meaning": {
          "enum": [
            "depth",
            "elevation",
            "time",
            "unknown"
          ],
          "title": "Z Meaning",
          "type": "string"
        },
        "positive": {
          "enum": [
            "up",
            "down",
            "unknown"
          ],
          "title": "Positive",
          "type": "string"
        },
        "vertical_datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Vertical Datum",
          "type": "string"
        },
        "registration": {
          "enum": [
            "corner",
            "center"
          ],
          "title": "Registration",
          "type": "string"
        },
        "row_order": {
          "const": "north-to-south",
          "title": "Row Order",
          "type": "string"
        },
        "ncols": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Ncols",
          "type": "integer"
        },
        "nrows": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Nrows",
          "type": "integer"
        },
        "cell_size": {
          "exclusiveMinimum": 0,
          "title": "Cell Size",
          "type": "number"
        },
        "x_first_center": {
          "title": "X First Center",
          "type": "number"
        },
        "y_first_center": {
          "title": "Y First Center",
          "type": "number"
        },
        "missing_count": {
          "maximum": 262144,
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "value_range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Range"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "crs",
        "xy_unit",
        "z_unit",
        "z_meaning",
        "positive",
        "vertical_datum",
        "registration",
        "row_order",
        "ncols",
        "nrows",
        "cell_size",
        "x_first_center",
        "y_first_center",
        "missing_count",
        "value_range",
        "fidelity"
      ],
      "title": "GridContext",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader).",
      "properties": {
        "reader": {
          "const": "asset_connectors.typed_reader/1",
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1",
            "well-location/1",
            "wavelet/1",
            "model-section/1",
            "seismic-section/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.regular-grid-surface/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/GridContext"
    },
    "values": {
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxItems": 262144,
      "minItems": 1,
      "title": "Values",
      "type": "array"
    },
    "nodata_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Nodata Value"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "values",
    "nodata_value"
  ],
  "title": "GridSurface",
  "type": "object"
}
