{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/assets/v1/seismic-line-schema.json",
  "x-ophiolite": {
    "id": "ophiolite.seismic-line/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "preserved": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Preserved",
          "type": "array"
        },
        "losses": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Losses",
          "type": "array"
        },
        "unknown_context": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unknown Context",
          "type": "array"
        },
        "decisions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decisions"
        }
      },
      "required": [
        "status",
        "preserved",
        "losses",
        "unknown_context"
      ],
      "title": "Fidelity",
      "type": "object"
    },
    "LineChunk": {
      "additionalProperties": false,
      "description": "A run of whole traces by 0-based file ordinal, inclusive, and the digest of their bytes (headers and samples).",
      "properties": {
        "first": {
          "minimum": 0,
          "title": "First",
          "type": "integer"
        },
        "last": {
          "minimum": 0,
          "title": "Last",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 244,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "first",
        "last",
        "sha256",
        "bytes"
      ],
      "title": "LineChunk",
      "type": "object"
    },
    "LineHeaderPositions": {
      "additionalProperties": false,
      "description": "1-based trace-header byte positions the line reader used (SEG-Y rev 1 standard, or as declared).",
      "properties": {
        "trace_number_byte": {
          "maximum": 237,
          "minimum": 1,
          "title": "Trace Number Byte",
          "type": "integer"
        },
        "source_point_byte": {
          "maximum": 237,
          "minimum": 1,
          "title": "Source Point Byte",
          "type": "integer"
        },
        "source_point_scalar_byte": {
          "maximum": 239,
          "minimum": 1,
          "title": "Source Point Scalar Byte",
          "type": "integer"
        },
        "x_byte": {
          "maximum": 237,
          "minimum": 1,
          "title": "X Byte",
          "type": "integer"
        },
        "y_byte": {
          "maximum": 237,
          "minimum": 1,
          "title": "Y Byte",
          "type": "integer"
        },
        "coordinate_scalar_byte": {
          "maximum": 239,
          "minimum": 1,
          "title": "Coordinate Scalar Byte",
          "type": "integer"
        }
      },
      "required": [
        "trace_number_byte",
        "source_point_byte",
        "source_point_scalar_byte",
        "x_byte",
        "y_byte",
        "coordinate_scalar_byte"
      ],
      "title": "LineHeaderPositions",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9.-]+)*/[0-9]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "key",
        "revision",
        "profile"
      ],
      "title": "Reference",
      "type": "object"
    },
    "SeismicLineContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "seismic-line",
          "title": "Type",
          "type": "string"
        },
        "format": {
          "enum": [
            "IBM 4-byte floating point",
            "IEEE 4-byte floating point"
          ],
          "title": "Format",
          "type": "string"
        },
        "format_code": {
          "enum": [
            1,
            5
          ],
          "title": "Format Code",
          "type": "integer"
        },
        "segy_revision": {
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$",
          "title": "Segy Revision",
          "type": "string"
        },
        "traces": {
          "maximum": 200000,
          "minimum": 1,
          "title": "Traces",
          "type": "integer"
        },
        "samples": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "trace_bytes": {
          "minimum": 244,
          "title": "Trace Bytes",
          "type": "integer"
        },
        "sample_interval": {
          "exclusiveMinimum": 0,
          "title": "Sample Interval",
          "type": "number"
        },
        "sample_unit": {
          "pattern": "^([A-Za-z0-9 ./^()\\-]{1,32}|unknown)$",
          "title": "Sample Unit",
          "type": "string"
        },
        "first_sample": {
          "title": "First Sample",
          "type": "number"
        },
        "z_domain": {
          "enum": [
            "time",
            "depth",
            "unknown"
          ],
          "title": "Z Domain",
          "type": "string"
        },
        "crs": {
          "pattern": "^(EPSG:[0-9]{4,6}|unknown)$",
          "title": "Crs",
          "type": "string"
        },
        "datum": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Datum",
          "type": "string"
        },
        "dataset": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset"
        },
        "line": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line"
        },
        "exceptions": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "array"
          },
          "maxItems": 64,
          "title": "Exceptions",
          "type": "array"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity"
        }
      },
      "required": [
        "type",
        "format",
        "format_code",
        "segy_revision",
        "traces",
        "samples",
        "trace_bytes",
        "sample_interval",
        "sample_unit",
        "first_sample",
        "z_domain",
        "crs",
        "datum",
        "dataset",
        "line",
        "exceptions",
        "fidelity"
      ],
      "title": "SeismicLineContext",
      "type": "object"
    },
    "TypedInterpretation": {
      "additionalProperties": false,
      "description": "The executable identity of the typed reader (Connectors typed_reader; E56: feature_files for feature sets).",
      "properties": {
        "reader": {
          "enum": [
            "asset_connectors.typed_reader/1",
            "asset_connectors.feature_files/1"
          ],
          "title": "Reader",
          "type": "string"
        },
        "mapping": {
          "enum": [
            "well-tops/1",
            "trajectory/1",
            "regular-grid-surface/1",
            "triangulated-surface/1",
            "point-set/1",
            "polyline-set/1",
            "seismic-volume/1",
            "well-location/1",
            "wavelet/1",
            "model-section/1",
            "seismic-section/1",
            "time-depth/1",
            "feature-set/1",
            "well-path/1",
            "well-set/1",
            "well-residual/1",
            "seismic-line/1"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "parsing_policy": {
          "const": "typed-strict/1",
          "title": "Parsing Policy",
          "type": "string"
        },
        "null_policy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Null Policy",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "mapping",
        "parsing_policy",
        "null_policy"
      ],
      "title": "TypedInterpretation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "E137 s0: a 2D seismic line's description: context, header decisions, every trace's position in file order\n(`[trace number, source point or null, x, y]`) and the digests of its runs of at most 1,024 whole traces. Samples\nare not copied; the exact original is the stored representation.",
  "properties": {
    "representation": {
      "const": "normalized",
      "title": "Representation",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Reference"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "interpretation": {
      "$ref": "#/$defs/TypedInterpretation"
    },
    "schema": {
      "const": "ophiolite.seismic-line/1",
      "title": "Schema",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/SeismicLineContext"
    },
    "decisions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "positions": {
      "$ref": "#/$defs/LineHeaderPositions"
    },
    "geometry": {
      "items": {
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "array"
      },
      "maxItems": 200000,
      "minItems": 1,
      "title": "Geometry",
      "type": "array"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/LineChunk"
      },
      "maxItems": 196,
      "minItems": 1,
      "title": "Chunks",
      "type": "array"
    }
  },
  "required": [
    "representation",
    "source",
    "source_sha256",
    "interpretation",
    "schema",
    "context",
    "decisions",
    "positions",
    "geometry",
    "chunks"
  ],
  "title": "SeismicLine",
  "type": "object"
}
