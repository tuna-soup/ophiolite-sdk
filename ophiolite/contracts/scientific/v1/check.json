{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/scientific/v1/check.json",
  "x-ophiolite": {
    "id": "ophiolite.check/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "AbsoluteTolerance": {
      "additionalProperties": false,
      "description": "In the compared quantity's unit.",
      "properties": {
        "kind": {
          "const": "absolute",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "title": "AbsoluteTolerance",
      "type": "object"
    },
    "CheckDifferences": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "largest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Largest"
        },
        "value_to_missing": {
          "minimum": 0,
          "title": "Value To Missing",
          "type": "integer"
        },
        "missing_to_value": {
          "minimum": 0,
          "title": "Missing To Value",
          "type": "integer"
        },
        "first": {
          "items": {
            "$ref": "#/$defs/CheckSample"
          },
          "maxItems": 20,
          "title": "First",
          "type": "array"
        },
        "changed_range": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  }
                ]
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Changed Range"
        }
      },
      "required": [
        "count",
        "total",
        "largest",
        "value_to_missing",
        "missing_to_value",
        "first",
        "changed_range"
      ],
      "title": "CheckDifferences",
      "type": "object"
    },
    "CheckFixture": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "display_name"
      ],
      "title": "CheckFixture",
      "type": "object"
    },
    "CheckImplementationSubject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "implementation",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "script_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Script Sha256",
          "type": "string"
        },
        "release_number": {
          "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,4}$",
          "title": "Release Number",
          "type": "string"
        },
        "release_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Digest",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "script_sha256",
        "release_number",
        "release_digest"
      ],
      "title": "CheckImplementationSubject",
      "type": "object"
    },
    "CheckPrincipal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "person",
            "workload"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "CheckPrincipal",
      "type": "object"
    },
    "CheckReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "independent-computation",
            "reference-file",
            "external-package"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "rights": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckRights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "digest"
      ],
      "title": "CheckReference",
      "type": "object"
    },
    "CheckResultSubject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "result",
          "title": "Kind",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "asset_id",
        "revision"
      ],
      "title": "CheckResultSubject",
      "type": "object"
    },
    "CheckRights": {
      "additionalProperties": false,
      "properties": {
        "licence": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "source": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "licence",
        "source"
      ],
      "title": "CheckRights",
      "type": "object"
    },
    "CheckSample": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "title": "At"
        },
        "reference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        },
        "output": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output"
        }
      },
      "required": [
        "at",
        "reference",
        "output"
      ],
      "title": "CheckSample",
      "type": "object"
    },
    "RelativeTolerance": {
      "additionalProperties": false,
      "description": "A dimensionless fraction of |reference|; a zero reference allows no difference.",
      "properties": {
        "kind": {
          "const": "relative",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "RelativeTolerance",
      "type": "object"
    },
    "CheckRefusal": {
      "additionalProperties": false,
      "description": "A refusal names exactly one field; nothing is stored.",
      "properties": {
        "field": {
          "enum": [
            "permission",
            "schema",
            "publisher",
            "tolerance",
            "interpretation",
            "fixture.digest",
            "reference.digest",
            "output.digest",
            "rights",
            "release.digest",
            "implementation.script_sha256",
            "outcome",
            "timeout",
            "capacity",
            "limit",
            "size",
            "request"
          ],
          "title": "Field",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "field",
        "message"
      ],
      "title": "CheckRefusal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "E96 (`ophiolite.check/1`): one comparison of an output with a reference under stated rules. The publisher states\nthe scientific fields; the server stores its own (`witness`, `recorded_by`, `command_id`, `at` and\n`server_output_digest` are the server's and absent from a published body). The tolerance is the one discriminated\nshape, `null` for exact equality. `$defs.CheckRefusal` is the refusal shape.",
  "properties": {
    "schema": {
      "const": "ophiolite.check/1",
      "title": "Schema",
      "type": "string"
    },
    "subject": {
      "discriminator": {
        "mapping": {
          "implementation": "#/$defs/CheckImplementationSubject",
          "result": "#/$defs/CheckResultSubject"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CheckImplementationSubject"
        },
        {
          "$ref": "#/$defs/CheckResultSubject"
        }
      ],
      "title": "Subject"
    },
    "fixture": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckFixture"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference": {
      "$ref": "#/$defs/CheckReference"
    },
    "output_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Digest",
      "type": "string"
    },
    "rules_id": {
      "enum": [
        "series-compare/1",
        "grid-compare/1"
      ],
      "title": "Rules Id",
      "type": "string"
    },
    "tolerance": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "absolute": "#/$defs/AbsoluteTolerance",
              "relative": "#/$defs/RelativeTolerance"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AbsoluteTolerance"
            },
            {
              "$ref": "#/$defs/RelativeTolerance"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "title": "Tolerance"
    },
    "request_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Request Digest"
    },
    "interpretation_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interpretation Digest"
    },
    "outcome": {
      "enum": [
        "passed",
        "differed",
        "not_compared"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "axis_mismatch",
            "unit_mismatch",
            "context_mismatch",
            "shape_mismatch",
            "another_kind",
            "declarations_missing",
            "declarations_incompatible",
            "unreadable",
            "too_large",
            "empty",
            "no_such_curve"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "differences": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckDifferences"
        },
        {
          "type": "null"
        }
      ]
    },
    "witness": {
      "anyOf": [
        {
          "enum": [
            "server",
            "claimed",
            "personal"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Witness"
    },
    "recorded_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckPrincipal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "command_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "At"
    },
    "server_output_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Server Output Digest"
    }
  },
  "required": [
    "schema",
    "subject",
    "fixture",
    "reference",
    "output_digest",
    "rules_id",
    "tolerance",
    "request_digest",
    "interpretation_digest",
    "outcome",
    "reason",
    "differences"
  ],
  "title": "CheckRecord",
  "type": "object"
}
