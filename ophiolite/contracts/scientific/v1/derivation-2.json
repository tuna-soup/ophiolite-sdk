{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/scientific/v1/derivation-2.json",
  "x-ophiolite": {
    "id": "ophiolite.derivation/2",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "ArrayNode": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "array",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "array": "#/$defs/ArrayNode",
                "boolean": "#/$defs/BooleanLeaf",
                "integer": "#/$defs/IntegerLeaf",
                "null": "#/$defs/NullLeaf",
                "number": "#/$defs/NumberLeaf",
                "object": "#/$defs/ObjectNode",
                "string": "#/$defs/StringLeaf"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NumberLeaf"
              },
              {
                "$ref": "#/$defs/IntegerLeaf"
              },
              {
                "$ref": "#/$defs/StringLeaf"
              },
              {
                "$ref": "#/$defs/BooleanLeaf"
              },
              {
                "$ref": "#/$defs/NullLeaf"
              },
              {
                "$ref": "#/$defs/ObjectNode"
              },
              {
                "$ref": "#/$defs/ArrayNode"
              }
            ]
          },
          "maxItems": 256,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "ArrayNode",
      "type": "object"
    },
    "BooleanLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "BooleanLeaf",
      "type": "object"
    },
    "DerivationDisplayV2": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterLabelV2"
          },
          "maxItems": 64,
          "title": "Parameters",
          "type": "array"
        }
      },
      "required": [
        "method",
        "parameters"
      ],
      "title": "DerivationDisplayV2",
      "type": "object"
    },
    "DerivationInput": {
      "additionalProperties": false,
      "description": "A parent by its slot and the salted lineage commitment the manifest carries for it; never an asset id.",
      "properties": {
        "slot": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Slot",
          "type": "string"
        },
        "commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "commitment"
      ],
      "title": "DerivationInput",
      "type": "object"
    },
    "DerivationOutput": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "role",
        "digest"
      ],
      "title": "DerivationOutput",
      "type": "object"
    },
    "DerivationProcedure": {
      "additionalProperties": false,
      "description": "E106: the catalogue version and the reported run a `reported` record was made by. `envelope_sha256` binds the\nserver's stored run envelope (the server's reader refuses a changed envelope; a portable reader checks the\nmanifest digest only).",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "rules_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "version_label": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version Label"
        },
        "step": {
          "enum": [
            "read",
            "source",
            "process",
            "send",
            "check"
          ],
          "title": "Step",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Id",
          "type": "string"
        },
        "envelope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Envelope Sha256",
          "type": "string"
        },
        "runner": {
          "$ref": "#/$defs/ProcedureRunner"
        },
        "again_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/MadeAgain"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "digest",
        "rules_version",
        "label",
        "version_label",
        "step",
        "run_id",
        "envelope_sha256",
        "runner",
        "again_of"
      ],
      "title": "DerivationProcedure",
      "type": "object"
    },
    "ImplementationV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Version Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "version_label"
      ],
      "title": "ImplementationV2",
      "type": "object"
    },
    "IntegerLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "integer",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(0|[1-9][0-9]{0,30})$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "IntegerLeaf",
      "type": "object"
    },
    "MadeAgain": {
      "additionalProperties": false,
      "description": "The earlier result this one was made again from, by its lineage commitment; never an asset id.",
      "properties": {
        "commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        }
      },
      "required": [
        "commitment"
      ],
      "title": "MadeAgain",
      "type": "object"
    },
    "NullLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "null",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "NullLeaf",
      "type": "object"
    },
    "NumberLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "number",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "NumberLeaf",
      "type": "object"
    },
    "ObjectNode": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object",
          "title": "Type",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ParameterEntry"
          },
          "maxItems": 64,
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "type",
        "entries"
      ],
      "title": "ObjectNode",
      "type": "object"
    },
    "ParameterChoice": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "ParameterChoice",
      "type": "object"
    },
    "ParameterEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "array": "#/$defs/ArrayNode",
              "boolean": "#/$defs/BooleanLeaf",
              "integer": "#/$defs/IntegerLeaf",
              "null": "#/$defs/NullLeaf",
              "number": "#/$defs/NumberLeaf",
              "object": "#/$defs/ObjectNode",
              "string": "#/$defs/StringLeaf"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberLeaf"
            },
            {
              "$ref": "#/$defs/IntegerLeaf"
            },
            {
              "$ref": "#/$defs/StringLeaf"
            },
            {
              "$ref": "#/$defs/BooleanLeaf"
            },
            {
              "$ref": "#/$defs/NullLeaf"
            },
            {
              "$ref": "#/$defs/ObjectNode"
            },
            {
              "$ref": "#/$defs/ArrayNode"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "ParameterEntry",
      "type": "object"
    },
    "ParameterLabelV2": {
      "additionalProperties": false,
      "description": "E106: a setting's words at publication; a choice setting keeps the labels of its values (a procedure's manifest).",
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "choices": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ParameterChoice"
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "ParameterLabelV2",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "description": "E94 (`ophiolite.parameters/1`): what must be given again to reproduce a calculation (`request`) and what that\nrequest resolved to when it ran (`resolved`), both canonical trees.",
      "properties": {
        "schema": {
          "const": "ophiolite.parameters/1",
          "title": "Schema",
          "type": "string"
        },
        "request": {
          "discriminator": {
            "mapping": {
              "array": "#/$defs/ArrayNode",
              "boolean": "#/$defs/BooleanLeaf",
              "integer": "#/$defs/IntegerLeaf",
              "null": "#/$defs/NullLeaf",
              "number": "#/$defs/NumberLeaf",
              "object": "#/$defs/ObjectNode",
              "string": "#/$defs/StringLeaf"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberLeaf"
            },
            {
              "$ref": "#/$defs/IntegerLeaf"
            },
            {
              "$ref": "#/$defs/StringLeaf"
            },
            {
              "$ref": "#/$defs/BooleanLeaf"
            },
            {
              "$ref": "#/$defs/NullLeaf"
            },
            {
              "$ref": "#/$defs/ObjectNode"
            },
            {
              "$ref": "#/$defs/ArrayNode"
            }
          ],
          "title": "Request"
        },
        "resolved": {
          "discriminator": {
            "mapping": {
              "array": "#/$defs/ArrayNode",
              "boolean": "#/$defs/BooleanLeaf",
              "integer": "#/$defs/IntegerLeaf",
              "null": "#/$defs/NullLeaf",
              "number": "#/$defs/NumberLeaf",
              "object": "#/$defs/ObjectNode",
              "string": "#/$defs/StringLeaf"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberLeaf"
            },
            {
              "$ref": "#/$defs/IntegerLeaf"
            },
            {
              "$ref": "#/$defs/StringLeaf"
            },
            {
              "$ref": "#/$defs/BooleanLeaf"
            },
            {
              "$ref": "#/$defs/NullLeaf"
            },
            {
              "$ref": "#/$defs/ObjectNode"
            },
            {
              "$ref": "#/$defs/ArrayNode"
            }
          ],
          "title": "Resolved"
        }
      },
      "required": [
        "schema",
        "request",
        "resolved"
      ],
      "title": "Parameters",
      "type": "object"
    },
    "ProcedureRunner": {
      "additionalProperties": false,
      "description": "Who reported the run: a person, or an agent with the person it acts for.",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "principal": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        },
        "on_behalf_of": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "On Behalf Of"
        }
      },
      "required": [
        "kind",
        "principal",
        "on_behalf_of"
      ],
      "title": "ProcedureRunner",
      "type": "object"
    },
    "ReleaseRecord": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,4}$",
          "title": "Number",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "number",
        "digest"
      ],
      "title": "ReleaseRecord",
      "type": "object"
    },
    "StringLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "string",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 1024,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "StringLeaf",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "E106 (`ophiolite.derivation/2`): `derivation/1` plus kind `reported`, choice labels in `display`, and the\n`procedure` block a reported record carries (and no other kind does). A reported record names every input\noccurrence as `<slot>[<n>]` (n from 0, in the run's order), so order and multiplicity are in `derivation_digest`,\nwhich is unchanged; one version may occur in several slots or positions.",
  "properties": {
    "schema": {
      "const": "ophiolite.derivation/2",
      "title": "Schema",
      "type": "string"
    },
    "kind": {
      "enum": [
        "executed",
        "declared",
        "edited",
        "received",
        "reported"
      ],
      "title": "Kind",
      "type": "string"
    },
    "implementation": {
      "$ref": "#/$defs/ImplementationV2"
    },
    "display": {
      "$ref": "#/$defs/DerivationDisplayV2"
    },
    "parameters": {
      "$ref": "#/$defs/Parameters"
    },
    "script_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Script Sha256"
    },
    "release": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/DerivationInput"
      },
      "maxItems": 64,
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/DerivationOutput"
      },
      "maxItems": 16,
      "title": "Outputs",
      "type": "array"
    },
    "execution_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution Id"
    },
    "request_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Request Id"
    },
    "procedure": {
      "anyOf": [
        {
          "$ref": "#/$defs/DerivationProcedure"
        },
        {
          "type": "null"
        }
      ]
    },
    "derivation_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Derivation Digest",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "kind",
    "implementation",
    "display",
    "parameters",
    "script_sha256",
    "release",
    "inputs",
    "outputs",
    "execution_id",
    "request_id",
    "procedure",
    "derivation_digest"
  ],
  "title": "DerivationRecordV2",
  "type": "object"
}
