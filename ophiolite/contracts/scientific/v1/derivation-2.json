{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/scientific/v1/derivation-2.json",
  "x-ophiolite": {
    "id": "ophiolite.derivation/2",
    "version": "1.2.0",
    "lifecycle": "preview"
  },
  "$defs": {
    "ArrayNode": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "array",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "array": "#/$defs/ArrayNode",
                "boolean": "#/$defs/BooleanLeaf",
                "integer": "#/$defs/IntegerLeaf",
                "null": "#/$defs/NullLeaf",
                "number": "#/$defs/NumberLeaf",
                "object": "#/$defs/ObjectNode",
                "string": "#/$defs/StringLeaf"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NumberLeaf"
              },
              {
                "$ref": "#/$defs/IntegerLeaf"
              },
              {
                "$ref": "#/$defs/StringLeaf"
              },
              {
                "$ref": "#/$defs/BooleanLeaf"
              },
              {
                "$ref": "#/$defs/NullLeaf"
              },
              {
                "$ref": "#/$defs/ObjectNode"
              },
              {
                "$ref": "#/$defs/ArrayNode"
              }
            ]
          },
          "maxItems": 256,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "ArrayNode",
      "type": "object"
    },
    "BooleanLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "BooleanLeaf",
      "type": "object"
    },
    "DerivationDisplayV2": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterLabelV2"
          },
          "maxItems": 64,
          "title": "Parameters",
          "type": "array"
        }
      },
      "required": [
        "method",
        "parameters"
      ],
      "title": "DerivationDisplayV2",
      "type": "object"
    },
    "DerivationInput": {
      "additionalProperties": false,
      "description": "A parent by its slot and the salted lineage commitment the manifest carries for it; never an asset id.",
      "properties": {
        "slot": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Slot",
          "type": "string"
        },
        "commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "commitment"
      ],
      "title": "DerivationInput",
      "type": "object"
    },
    "DerivationNotVerified": {
      "additionalProperties": false,
      "description": "E165 s2: nobody had verified the tool version when this result was published.",
      "properties": {
        "state": {
          "const": "none",
          "title": "State",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "null"
        },
        "by": {
          "title": "By",
          "type": "null"
        },
        "at": {
          "title": "At",
          "type": "null"
        },
        "reference_label": {
          "title": "Reference Label",
          "type": "null"
        },
        "line": {
          "const": "Not verified",
          "title": "Line",
          "type": "string"
        }
      },
      "required": [
        "state",
        "id",
        "by",
        "at",
        "reference_label",
        "line"
      ],
      "title": "DerivationNotVerified",
      "type": "object"
    },
    "DerivationOutput": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "role",
        "digest"
      ],
      "title": "DerivationOutput",
      "type": "object"
    },
    "DerivationProcedure": {
      "additionalProperties": false,
      "description": "E106: the catalogue version and the reported run a `reported` record was made by. `envelope_sha256` binds the\nserver's stored run envelope (the server's reader refuses a changed envelope; a portable reader checks the\nmanifest digest only).",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "rules_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "version_label": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version Label"
        },
        "step": {
          "enum": [
            "read",
            "source",
            "process",
            "send",
            "check"
          ],
          "title": "Step",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Id",
          "type": "string"
        },
        "envelope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Envelope Sha256",
          "type": "string"
        },
        "runner": {
          "$ref": "#/$defs/ProcedureRunner"
        },
        "again_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/MadeAgain"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "discriminator": {
            "mapping": {
              "none": "#/$defs/DerivationNotVerified",
              "verified": "#/$defs/DerivationVerified",
              "withdrawn": "#/$defs/DerivationWithdrawn"
            },
            "propertyName": "state"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DerivationVerified"
            },
            {
              "$ref": "#/$defs/DerivationWithdrawn"
            },
            {
              "$ref": "#/$defs/DerivationNotVerified"
            }
          ],
          "title": "Verification"
        },
        "witness": {
          "$ref": "#/$defs/DerivationWitness"
        }
      },
      "required": [
        "digest",
        "rules_version",
        "label",
        "version_label",
        "step",
        "run_id",
        "envelope_sha256",
        "runner",
        "again_of"
      ],
      "title": "DerivationProcedure",
      "type": "object"
    },
    "DerivationVerified": {
      "additionalProperties": false,
      "description": "E165 s2: the tool version was verified when this result was published (`tool_verifications.state` then), with\n`line`, the sentence the catalogue showed at that moment, stored verbatim and never re-rendered.",
      "properties": {
        "state": {
          "const": "verified",
          "title": "State",
          "type": "string"
        },
        "id": {
          "pattern": "^verification-[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/VerifierPerson"
        },
        "at": {
          "title": "At",
          "type": "number"
        },
        "reference_label": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Reference Label",
          "type": "string"
        },
        "line": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Line",
          "type": "string"
        }
      },
      "required": [
        "state",
        "id",
        "by",
        "at",
        "reference_label",
        "line"
      ],
      "title": "DerivationVerified",
      "type": "object"
    },
    "DerivationWithdrawn": {
      "additionalProperties": false,
      "description": "E165 s2: every verification of the tool version was withdrawn when this result was published; `id`, `by` and\n`at` are the newest withdrawal's.",
      "properties": {
        "state": {
          "const": "withdrawn",
          "title": "State",
          "type": "string"
        },
        "id": {
          "pattern": "^verification-[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/VerifierPerson"
        },
        "at": {
          "title": "At",
          "type": "number"
        },
        "reference_label": {
          "title": "Reference Label",
          "type": "null"
        },
        "line": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Line",
          "type": "string"
        }
      },
      "required": [
        "state",
        "id",
        "by",
        "at",
        "reference_label",
        "line"
      ],
      "title": "DerivationWithdrawn",
      "type": "object"
    },
    "DerivationWitness": {
      "additionalProperties": false,
      "description": "E113 s0: Ophiolite ran this run in the project's sandbox. Written by the server's runner only (slice 1); the\nrunner of the run stays the person who started it, or the assistant on behalf of that person.",
      "properties": {
        "kind": {
          "const": "sandbox",
          "title": "Kind",
          "type": "string"
        },
        "job": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Job",
          "type": "string"
        },
        "image": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "runtime": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9.+-]*$",
          "title": "Runtime",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/WitnessLimits"
        },
        "network": {
          "const": "none",
          "title": "Network",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "number"
        },
        "finished_at": {
          "title": "Finished At",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "job",
        "image",
        "runtime",
        "limits",
        "network",
        "started_at",
        "finished_at"
      ],
      "title": "DerivationWitness",
      "type": "object"
    },
    "ImplementationV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Version Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "version_label"
      ],
      "title": "ImplementationV2",
      "type": "object"
    },
    "IntegerLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "integer",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(0|[1-9][0-9]{0,30})$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "IntegerLeaf",
      "type": "object"
    },
    "MadeAgain": {
      "additionalProperties": false,
      "description": "The earlier result this one was made again from, by its lineage commitment; never an asset id.",
      "properties": {
        "commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        }
      },
      "required": [
        "commitment"
      ],
      "title": "MadeAgain",
      "type": "object"
    },
    "NullLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "null",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "NullLeaf",
      "type": "object"
    },
    "NumberLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "number",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "NumberLeaf",
      "type": "object"
    },
    "ObjectNode": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object",
          "title": "Type",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ParameterEntry"
          },
          "maxItems": 64,
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "type",
        "entries"
      ],
      "title": "ObjectNode",
      "type": "object"
    },
    "ParameterChoice": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "ParameterChoice",
      "type": "object"
    },
    "ParameterEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "array": "#/$defs/ArrayNode",
              "boolean": "#/$defs/BooleanLeaf",
              "integer": "#/$defs/IntegerLeaf",
              "null": "#/$defs/NullLeaf",
              "number": "#/$defs/NumberLeaf",
              "object": "#/$defs/ObjectNode",
              "string": "#/$defs/StringLeaf"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberLeaf"
            },
            {
              "$ref": "#/$defs/IntegerLeaf"
            },
            {
              "$ref": "#/$defs/StringLeaf"
            },
            {
              "$ref": "#/$defs/BooleanLeaf"
            },
            {
              "$ref": "#/$defs/NullLeaf"
            },
            {
              "$ref": "#/$defs/ObjectNode"
            },
            {
              "$ref": "#/$defs/ArrayNode"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "ParameterEntry",
      "type": "object"
    },
    "ParameterLabelV2": {
      "additionalProperties": false,
      "description": "E106: a setting's words at publication; a choice setting keeps the labels of its values (a procedure's manifest).",
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "choices": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ParameterChoice"
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "ParameterLabelV2",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "description": "E94 (`ophiolite.parameters/1`): what must be given again to reproduce a calculation (`request`) and what that\nrequest resolved to when it ran (`resolved`), both canonical trees.",
      "properties": {
        "schema": {
          "const": "ophiolite.parameters/1",
          "title": "Schema",
          "type": "string"
        },
        "request": {
          "discriminator": {
            "mapping": {
              "array": "#/$defs/ArrayNode",
              "boolean": "#/$defs/BooleanLeaf",
              "integer": "#/$defs/IntegerLeaf",
              "null": "#/$defs/NullLeaf",
              "number": "#/$defs/NumberLeaf",
              "object": "#/$defs/ObjectNode",
              "string": "#/$defs/StringLeaf"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberLeaf"
            },
            {
              "$ref": "#/$defs/IntegerLeaf"
            },
            {
              "$ref": "#/$defs/StringLeaf"
            },
            {
              "$ref": "#/$defs/BooleanLeaf"
            },
            {
              "$ref": "#/$defs/NullLeaf"
            },
            {
              "$ref": "#/$defs/ObjectNode"
            },
            {
              "$ref": "#/$defs/ArrayNode"
            }
          ],
          "title": "Request"
        },
        "resolved": {
          "discriminator": {
            "mapping": {
              "array": "#/$defs/ArrayNode",
              "boolean": "#/$defs/BooleanLeaf",
              "integer": "#/$defs/IntegerLeaf",
              "null": "#/$defs/NullLeaf",
              "number": "#/$defs/NumberLeaf",
              "object": "#/$defs/ObjectNode",
              "string": "#/$defs/StringLeaf"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberLeaf"
            },
            {
              "$ref": "#/$defs/IntegerLeaf"
            },
            {
              "$ref": "#/$defs/StringLeaf"
            },
            {
              "$ref": "#/$defs/BooleanLeaf"
            },
            {
              "$ref": "#/$defs/NullLeaf"
            },
            {
              "$ref": "#/$defs/ObjectNode"
            },
            {
              "$ref": "#/$defs/ArrayNode"
            }
          ],
          "title": "Resolved"
        }
      },
      "required": [
        "schema",
        "request",
        "resolved"
      ],
      "title": "Parameters",
      "type": "object"
    },
    "ProcedureRunner": {
      "additionalProperties": false,
      "description": "Who reported the run: a person, or an agent with the person it acts for.",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "principal": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        },
        "on_behalf_of": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "On Behalf Of"
        }
      },
      "required": [
        "kind",
        "principal",
        "on_behalf_of"
      ],
      "title": "ProcedureRunner",
      "type": "object"
    },
    "ReleaseRecord": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,4}$",
          "title": "Number",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "number",
        "digest"
      ],
      "title": "ReleaseRecord",
      "type": "object"
    },
    "StringLeaf": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "string",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 1024,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "StringLeaf",
      "type": "object"
    },
    "VerifierPerson": {
      "additionalProperties": false,
      "description": "E93's actor shape, persons only: an assistant never authors a verification (slice 1's `reach: person` is the\nfirst layer, this is the second). Named apart from the assets contract's `Person`: the SDK generates one model per\nname across every contract.",
      "properties": {
        "kind": {
          "const": "person",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name_at_time": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name At Time"
        }
      },
      "required": [
        "kind",
        "id",
        "name_at_time"
      ],
      "title": "VerifierPerson",
      "type": "object"
    },
    "WitnessLimits": {
      "additionalProperties": false,
      "description": "E113 s0: the limits the box ran with, all three, as the runner applied them (never above the deployment's).",
      "properties": {
        "memory_mb": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Memory Mb",
          "type": "integer"
        },
        "seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Seconds",
          "type": "integer"
        },
        "cpus": {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "title": "Cpus",
          "type": "number"
        }
      },
      "required": [
        "memory_mb",
        "seconds",
        "cpus"
      ],
      "title": "WitnessLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "E106 (`ophiolite.derivation/2`): `derivation/1` plus kind `reported`, choice labels in `display`, and the\n`procedure` block a reported record carries (and no other kind does). A reported record names every input\noccurrence as `<slot>[<n>]` (n from 0, in the run's order), so order and multiplicity are in `derivation_digest`,\nwhich is unchanged; one version may occur in several slots or positions.",
  "properties": {
    "schema": {
      "const": "ophiolite.derivation/2",
      "title": "Schema",
      "type": "string"
    },
    "kind": {
      "enum": [
        "executed",
        "declared",
        "edited",
        "received",
        "reported"
