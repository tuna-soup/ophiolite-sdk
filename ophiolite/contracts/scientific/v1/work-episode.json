      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "description": "A pseudonym; its prefix is the kind",
          "pattern": "^(person|agent)-[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EpisodeActor",
      "type": "object"
    },
    "EpisodeBehalf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "person",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^person-[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EpisodeBehalf",
      "type": "object"
    },
    "EpisodeCheck": {
      "additionalProperties": false,
