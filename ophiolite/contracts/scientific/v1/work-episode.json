{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/scientific/v1/work-episode.json",
  "x-ophiolite": {
    "id": "ophiolite.work-episode/1",
    "version": "1.1.0",
    "lifecycle": "preview"
  },
