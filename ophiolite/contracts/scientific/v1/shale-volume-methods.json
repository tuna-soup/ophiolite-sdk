{
 "schema": "ophiolite.shale-volume-methods/1",
 "id": "ophiolite.shale-volume-methods/1",
 "title": "Shale volume from gamma ray: the formulas, their constants and the values both runtimes are held to",
 "index": {
  "name": "gamma-ray index (IGR)",
  "formula": "(GR/2 - clean/2) / (shale/2 - clean/2), then clipped to 0..1",
  "why_halved": "Halving is exact in binary floating point, so ordinary values equal the plain (GR - clean)/(shale - clean); the difference of two finite halves cannot overflow."
 },
 "input": {
  "quantity": "Gamma Ray",
  "units": [
   "gAPI",
   "API"
  ]
 },
 "output": {
  "curve": "VSH",
  "unit": "V/V",
  "quantity": "Shale Volume Fraction",
  "null": -999.25
 },
 "percentile": {
  "definition": "linear interpolation between closest ranks (Hyndman and Fan type 7): h = (n - 1) p / 100, value = x[floor h] + (h - floor h)(x[floor h + 1] - x[floor h]) over the sorted non-missing samples in the half-open depth range [top, base)",
  "default_low": 5,
  "default_high": 95
 },
 "max_samples": 100000,
 "method_record": {
  "name": "ophiolite.shale-volume",
  "library": "ophiolite-platform",
  "parameter_keys": [
   "method",
   "picks",
   "clip",
   "table",
   "inputs",
   "outputs"
  ]
 },
 "record_sentence": {
  "typed": "Shale volume from gamma ray: {label}; clean {clean} {unit} and shale {shale} {unit}, typed; clipped to 0-1; method table {table}.",
  "percentile": "Shale volume from gamma ray: {label}; clean {clean} {unit} and shale {shale} {unit}, the {low}th and {high}th percentile between {top} and {base} {depth_unit}; clipped to 0-1; method table {table}."
 },
