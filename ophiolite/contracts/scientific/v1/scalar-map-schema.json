{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophiolite.dev/contracts/scientific/v1/scalar-map-schema.json",
  "x-ophiolite": {
    "id": "ophiolite/scalar-map/1",
    "version": "1.0.0",
    "lifecycle": "preview"
  },
  "title": "ScalarMap",
  "description": "Structural shape of an ophiolite/scalar-map/1 exchange snapshot. Grid shape versus sample count and the metadata_json object rules cannot be expressed here; project_gateway.catalog.validate_snapshot checks them. Unknown fields are extensions and are kept.",
  "type": "object",
  "required": ["kind", "unit", "scalar_map"],
  "properties": {
    "kind": {"const": "scalar-map"},
    "unit": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "scalar_map": {"$ref": "#/$defs/ScalarGrid"},
    "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string"}
  },
  "$defs": {
    "ScalarGrid": {
      "type": "object",
      "required": ["width", "height", "values", "metadata_json"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "first_x": {"type": "number"},
        "first_y": {"type": "number"},
        "step_x": {"type": "number", "exclusiveMinimum": 0},
        "step_y": {"type": "number", "exclusiveMinimum": 0},
        "values": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"anyOf": [{"type": "number"}, {"const": "NaN"}]}},
        "metadata_json": {"type": "string", "minLength": 2}
      }
    }
  }
}
